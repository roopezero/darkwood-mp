root = true

[*.cs]
indent_style = space
indent_size = 4
tab_width = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 80

# IDE0011: every if, else, loop, using and lock has braces.
csharp_prefer_braces = true

# IDE0055: braces go on their own lines.
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# true keeps "public bool X { get; init; }" on one line; DW0002 forbids the
# one-line blocks this leaves open. false wraps "if (x) { return; }" and
# "a(); b();".
csharp_preserve_single_line_blocks = true
csharp_preserve_single_line_statements = false

# Errors by default: the core, the tests and the map tests.
dotnet_diagnostic.IDE0011.severity = error
dotnet_diagnostic.IDE0055.severity = error
dotnet_analyzer_diagnostic.category-DarkwoodFormatting.severity = error

# The plugin stays at warnings until the formatting pass has been over its code.
[src/DarkwoodMP/**.cs]
dotnet_diagnostic.IDE0011.severity = warning
dotnet_diagnostic.IDE0055.severity = warning
dotnet_analyzer_diagnostic.category-DarkwoodFormatting.severity = warning

# Folders the formatting pass has cleaned: uncomment this section and list
# each folder. It must stay last, because the last matching section wins.
# [src/DarkwoodMP/{World/Doors,Net}/**.cs]
# dotnet_diagnostic.IDE0011.severity = error
# dotnet_diagnostic.IDE0055.severity = error
# dotnet_analyzer_diagnostic.category-DarkwoodFormatting.severity = error
