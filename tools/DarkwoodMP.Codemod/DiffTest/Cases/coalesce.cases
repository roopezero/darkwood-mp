=== declaration, the right side runs only for a null left side
public static object Run(string a, string b)
{
    string x = Log("a", a) ?? Log("b", b);
    return x;
}
=== declaration of a chain ending in a literal
public static object Run(string a, string b)
{
    var x = Log("a", a) ?? Log("b", b) ?? "none";
    return x;
}
=== declaration whose last value throws
public static object Run(string a)
{
    string x = Log("a", a) ?? throw new ArgumentException("no " + a);
    return x.Length;
}
=== a var declaration keeps the type of its ??
static string Kind(object value)
{
    return "object";
}

static string Kind(string value)
{
    return "string";
}

public static object Run(string a, string b)
{
    var x = Log("a", a) ?? Log("b", b);
    return Kind(x);
}
=== Nullable left with a literal and with a call last
static int s_calls;

static int Next()
{
    s_calls++;
    return Log("next", s_calls);
}

public static object Run(int? n, int? m)
{
    int x = Log("n", n) ?? 5;
    int y = m ?? Next();
    return (x, y, s_calls);
}
=== Nullable field left goes through a temporary
static int? s_limit;

public static object Run(int? n, int i)
{
    s_limit = n;
    int x = s_limit ?? Log("i", i);
    return x;
}
=== Nullable left of another type keeps the natural type double
public static object Run(int? n)
{
    object o = Log("n", n) ?? 2.5;
    return o.GetType().Name + " " + o;
}
=== both Nullable, filled by a nullable conversion
public static object Run(int? n, long? m)
{
    long? x = Log("n", n) ?? Log("m", m);
    return x;
}
=== assignment to a field is written once, with the final value
static string s_name;

static string Fallback()
{
    Log("seen", s_name);
    return "fallback";
}

public static object Run(string a, string first)
{
    s_name = first;
    s_name = Log("a", a) ?? Fallback();
    return s_name;
}
=== assignment to a local that is the first value
public static object Run(string a, string b)
{
    a = a ?? Log("b", b);
    return a;
}
=== a field that is its own first value is read once
static string s_text;

public static object Run(string a)
{
    s_text = a;
    s_text = s_text ?? Log("made", "made");
    return s_text;
}
=== return of a ?? and of a chain
public static object Run(bool c, string a, string b)
{
    if (c)
    {
        return Log("a", a) ?? Log("b", b);
    }
    return a ?? b ?? Log("last", "last");
}
=== a ?. of a value type with a literal last
public static object Run(UnityObject u, string s)
{
    int count = s?.Length ?? -1;
    return count;
}
=== a ?. of a reference with a call last
static string Name()
{
    return Log("name", "named");
}

public static object Run(string s)
{
    string trimmed = s?.Trim() ?? Name();
    return trimmed;
}
=== a ?. whose receiver is read once through a temporary
static int s_reads;
static string s_value;

static string Value
{
    get
    {
        s_reads++;
        return s_value;
    }
}

public static object Run(string s, string b)
{
    s_value = s;
    var length = Value?.Length ?? Log("b", b).Length;
    return (length, s_reads);
}
=== a ?. of a value type into a Nullable
public static object Run(string s, int? m)
{
    int? length = s?.Length ?? m;
    return length;
}
=== a ??= statement on a local, a field and a Nullable
static string s_cache;
static int? s_limit;

public static object Run(string a, string b, int? n)
{
    s_cache = b;
    a ??= Log("a made", "made");
    s_cache ??= Log("cache made", "cache");
    s_limit = n;
    s_limit ??= Log("limit", 8);
    return (a, s_cache, s_limit);
}
=== a nested ??= on a local and on a field
static List<int> s_items;

public static object Run(bool has, int i, bool reset)
{
    List<int> given = null;
    if (has)
    {
        given = new List<int> { 7 };
    }
    if (reset)
    {
        s_items = null;
    }
    (given ??= new List<int>()).Add(Log("i", i));
    (s_items ??= new List<int>()).Add(i);
    return (given, s_items);
}
=== a nested ??= on a property is read and written once
static int s_gets;
static int s_sets;
static List<int> s_backing;

static List<int> Items
{
    get
    {
        s_gets++;
        return s_backing;
    }
    set
    {
        s_sets++;
        s_backing = value;
    }
}

public static object Run(bool has, int i)
{
    s_backing = null;
    if (has)
    {
        s_backing = new List<int> { 7 };
    }
    (Items ??= new List<int>()).Add(i);
    return (s_gets, s_sets, s_backing);
}
=== arguments and holes move in the order they run
static string Join(string a, string b)
{
    return a + "|" + b;
}

public static object Run(string a, string b, int? n)
{
    var both = Join(Log("a", a) ?? "x", Log("b", b) ?? "y");
    var text = $"{Log("a2", a) ?? "none",6}:{n ?? 0:0.0}";
    return both + text;
}
=== a ?? in an if condition and a foreach source
public static object Run(string a, bool has)
{
    List<int> list = null;
    if (has)
    {
        list = new List<int> { 2, 3 };
    }
    int total = 0;
    if ((Log("a", a) ?? "").Length > 0)
    {
        total++;
    }
    foreach (var item in Log("list", list) ?? new List<int>())
    {
        total += item;
    }
    return total;
}
=== a call earlier in the statement stays, the site after it moves
static int s_n;

static int Bump()
{
    s_n++;
    return s_n;
}

static int Sum(int a, int b)
{
    return a + b;
}

public static object Run(int? n, string a)
{
    s_n = 10;
    var kept = Sum(s_n, n ?? Bump());
    var moved = (Log("a", a) ?? "z").Length;
    return (kept, moved, s_n);
}
=== an object with an == of its own stays as written
public static object Run(UnityObject u, UnityObject v, string a)
{
    var near = u ?? v;
    var name = a ?? "none";
    return (near, name);
}
=== a derived type fills a temporary of its base type
public static object Run(string s, object o)
{
    object x = Log("s", s) ?? Log("o", o);
    return x;
}
=== a value that converts by code of its own stays as written
class Box
{
    public string Text;

    public static implicit operator Box(string text)
    {
        return new Box { Text = Log("convert", text) };
    }
}

public static object Run(string a, string b)
{
    string seen = Log("seen", b) ?? "none";
    Box x = Log("a", a) ?? new Box { Text = "made" };
    return (x.Text, seen);
}
=== a delegate's null check is a reference check
public static object Run(bool c, int i)
{
    Func<int> given = null;
    if (c)
    {
        given = () => i;
    }
    Func<int> make = given ?? (() =>
    {
        return Log("default", -1);
    });
    return make();
}
=== a ?: on the right runs only when the left side is null
public static object Run(bool c, string a, string b)
{
    var pick = Log("a", a) ?? (Log("c", c) ? b : "c");
    return pick;
}
=== a ?? on the right of && runs only when the left side is true
public static object Run(bool c, string a, string b)
{
    string seen = Log("seen", b) ?? "none";
    return (c && (Log("a", a) ?? Log("b", b)).Length > 0, seen);
}
=== a ?? on the right of || runs only when the left side is false
public static object Run(bool c, string a, string b)
{
    string seen = Log("seen", b) ?? "none";
    return (c || (Log("a", a) ?? Log("b", b)).Length > 0, seen);
}
=== a ?? in a branch of ?: runs only when that branch is taken
public static object Run(bool c, string a, string b)
{
    string seen = Log("seen", b) ?? "none";
    return (c ? Log("a", a) ?? Log("b", b) : "none", seen);
}
=== a ?? in a lambda body runs each time the lambda does
public static object Run(string a, string b)
{
    string seen = Log("seen", b) ?? "none";
    Func<string> f = () => Log("a", a) ?? Log("b", b);
    Log("between", 0);
    return f() + f() + seen;
}
=== a ?? after ?. runs only when the receiver isn't null
public static object Run(string r, string a, string b)
{
    string seen = Log("seen", b) ?? "none";
    return (Log("r", r)?.Insert(0, Log("a", a) ?? Log("b", b)), seen);
}
=== a chain assigned to a local fills the local itself
public static object Run(string a, string b)
{
    string x = Log("old", "old");
    x = Log("a", a) ?? Log("b", b) ?? "none";
    return x;
}
=== x = y ?? b on two locals fills x with y
public static object Run(string y, string b)
{
    string x = Log("old", "old");
    x = y ?? Log("b", b);
    return x;
}
=== x += a ?? b keeps the temporary
public static object Run(string a, string b)
{
    string x = Log("old", "old");
    x += Log("a", a) ?? Log("b", b);
    return x;
}
=== a later value that reads the local keeps the temporary
public static object Run(string a, string b)
{
    string x = Log("b", b);
    x = Log("a", a) ?? x;
    return x;
}
=== x = x?.Next ?? b keeps the temporary
class Node
{
    public Node Next;
    public string Name;
}

public static object Run(bool made, bool linked, string b)
{
    Node x = null;
    if (made)
    {
        x = new Node { Name = "first" };
        if (linked)
        {
            x.Next = new Node { Name = "next" };
        }
    }
    x = x?.Next ?? new Node { Name = Log("b", b) };
    return x.Name;
}
=== inside a try, a call after the first store keeps the temporary
static string Fail(string a)
{
    throw new InvalidOperationException("no " + a);
}

public static object Run(string a, string b)
{
    string x = "old";
    try
    {
        x = Log("a", a) ?? Fail(b);
    }
    catch (InvalidOperationException)
    {
    }
    return x;
}
=== inside a try, a literal after the first store fills the local
static bool? Flag(int? n)
{
    if (n == null)
    {
        return null;
    }
    return Log("flag", n.Value > 0);
}

public static object Run(int? n)
{
    bool dead = true;
    try
    {
        dead = Flag(n) ?? false;
    }
    catch (InvalidOperationException)
    {
        return "caught";
    }
    return dead;
}
=== a Nullable and a ?. unwrapped into a local
public static object Run(int? n, string s)
{
    int x = 7;
    x = Log("n", n) ?? 5;
    int count = 3;
    count = Log("s", s)?.Length ?? -1;
    return (x, count);
}
=== a local refilled in front of its statement
static string Clean(string text)
{
    return Log("clean", text + "!");
}

public static object Run(string name, string b)
{
    name = Clean(name ?? Log("b", b));
    return name;
}
=== a local read again in its statement keeps the temporary
public static object Run(string name)
{
    name = string.Concat(Log("first", name ?? ""), Log("again", name));
    return name;
}
=== x = f(y ?? b) leaves y as it was
static string Twice(string text)
{
    return Log("twice", text + text);
}

public static object Run(string y, string b)
{
    string x = Log("old", "old");
    x = Twice(y ?? Log("b", b));
    return (x, y);
}
=== x += f(x ?? b) keeps the temporary
static string Twice(string text)
{
    return Log("twice", text + text);
}

public static object Run(string a, string b)
{
    string x = Log("a", a);
    x += Twice(x ?? Log("b", b));
    return x;
}
=== x ?? (x = v) on a local is x ??= v
public static object Run(string a, int d)
{
    List<int> gone = null;
    if (a != null)
    {
        gone = new List<int>();
        gone.Add(-1);
    }
    (gone ?? (gone = Log("new", new List<int>()))).Add(d);
    return gone;
}
=== x ?? (x = v) ?? w keeps its last value
public static object Run(string a, string v, string w)
{
    string x = Log("a", a);
    string r = (x ?? (x = Log("v", v)) ?? Log("w", w)).Trim();
    return (r, x);
}
=== x ?? (y = v) on two locals keeps the ?? of x
public static object Run(string a, string b)
{
    string x = Log("a", a);
    string y = Log("b", b);
    string r = (x ?? (y = Log("v", "v"))).ToUpper();
    return (r, x, y);
}
=== x = a ?? b on a local a lambda reads keeps the temporary
public static object Run(string a)
{
    string x = Log("old", "old");
    Func<string> f = () => Log("seen", x);
    x = Log("a", a) ?? f();
    return x;
}
=== x = a ?? b on a ref parameter keeps the temporary
static string s_field;

static void Fill(ref string x, string a)
{
    x = Log("a", a) ?? Log("seen", s_field);
}

public static object Run(string a, string b)
{
    s_field = b;
    Fill(ref s_field, a);
    return s_field;
}
=== inside a try, a ?. first value keeps the temporary
class Named
{
    public bool Fails;

    public string Name
    {
        get
        {
            if (Fails)
            {
                throw new InvalidOperationException("no name");
            }
            return Log("name", "named");
        }
    }
}

public static object Run(bool made, bool fails)
{
    Named r = null;
    if (made)
    {
        r = new Named { Fails = fails };
    }
    string x = Log("old", "old");
    try
    {
        x = r?.Name ?? "none";
    }
    catch (InvalidOperationException)
    {
    }
    return x;
}
=== x = f(x ?? b) on a local a lambda reads keeps the temporary
public static object Run(string a, string b)
{
    string x = Log("a", a);
    Func<string, string> f = s => Log("seen", x) + s;
    x = f(x ?? Log("b", b));
    return x;
}
=== x = f(x ?? b) on a ref parameter keeps the temporary
static string s_text;

static string Seen(string text)
{
    return Log("seen", s_text) + text;
}

static void Refill(ref string x, string b)
{
    x = Seen(x ?? Log("b", b));
}

public static object Run(string a, string b)
{
    s_text = a;
    Refill(ref s_text, b);
    return s_text;
}
=== inside a try, x = f(x ?? b) keeps the temporary
public static object Run(string a, string b, int n)
{
    string x = Log("a", a);
    try
    {
        x = (x ?? Log("b", b)).Substring(Log("n", n));
    }
    catch (ArgumentOutOfRangeException)
    {
    }
    return x;
}
