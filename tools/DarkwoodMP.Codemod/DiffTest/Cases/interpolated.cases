=== null holes, a string in the head and in the tail
public static object Run(string a, string b)
{
    string s = $"a null hole {Log("a", a)} in the head and a null string {Log("b", b)} in the tail of this long line";
    return s;
}
=== an IFormattable hole with a format, made into text once
sealed class Money : IFormattable
{
    public int Cents;

    public string ToString(string format, IFormatProvider provider)
    {
        return Log("format " + format, "M" + Cents + ":" + format);
    }

    public override string ToString()
    {
        return Log("plain", "plain");
    }
}

public static object Run(int n)
{
    var money = new Money { Cents = n };
    string s = $"an amount {money:0.00} with a format, and then a long tail of words {n,6:X} at the end";
    return s;
}
=== a culture-sensitive value, in a culture with a decimal comma
public static object Run(double x)
{
    var thread = System.Threading.Thread.CurrentThread;
    var saved = thread.CurrentCulture;
    var comma = (System.Globalization.CultureInfo)System.Globalization.CultureInfo.InvariantCulture.Clone();
    comma.NumberFormat.NumberDecimalSeparator = ",";
    thread.CurrentCulture = comma;
    try
    {
        string s = $"a value {x:0.00} in the current culture, then more words and {x} again at the end";
        return s;
    }
    finally
    {
        thread.CurrentCulture = saved;
    }
}
=== a ToString with a side effect runs once per hole, in order
sealed class Noisy
{
    public static int Calls;
    public string Name;

    public override string ToString()
    {
        Calls++;
        return Log("ToString " + Name, Name + Calls);
    }
}

public static object Run(int n)
{
    var a = new Noisy { Name = "a" };
    var b = new Noisy { Name = "b" };
    string s = $"first {a} and then a long run of words to pass the column limit here {b} and {n}";
    return (s, Noisy.Calls);
}
=== alignments, with and without a format
public static object Run(int n, string a)
{
    string s = $"[{Log("n", n),5}] and [{Log("a", a),-8}] then a long run of words to pass the limit [{n,-3:D2}]";
    return s;
}
