=== an argument after values the call in the ?: can't change
static int s_calls;

static int Bump(int x)
{
    s_calls++;
    return Log("bump", x + s_calls);
}

static int Sum(int a, int b, int c)
{
    return Log("sum", a + b + c);
}

public static object Run(bool c, int i, int j)
{
    return Sum(i, 7, Log("c", c) ? Bump(i) : Log("j", j));
}
=== a ?: without effects after reads that throw for null
static int s_n = 5;

static object Three(int a, int b, int c)
{
    return (a, b, c);
}

public static object Run(bool c, int i, UnityObject u)
{
    return Three(s_n, u.Count, c ? i : -i);
}
=== a double the ?: makes stays a double in an object argument (hazard 1)
static object Box(object o)
{
    return o;
}

public static object Run(bool c, int i)
{
    return Box(Log("c", c) ? i : 2.5);
}
=== overloads still see the natural type
static string Pick(int x)
{
    return "int " + x;
}

static string Pick(long x)
{
    return "long " + x;
}

static string Pick(object x)
{
    return "object";
}

public static object Run(bool c, int i, long n)
{
    var first = Pick(Log("c", c) ? i : n);
    var second = Pick(c ? (short)i : (short)1);
    return (first, second);
}
=== a format and an alignment stay in the hole
public static object Run(bool c, int i)
{
    return $"[{(Log("c", c) ? i * 1.5 : 0.25):0.00}|{(c ? "yes" : "no"),5}|{Log("i", i)}]";
}
=== an earlier plain hole and a call in the ?:
static int Twice(int x)
{
    return Log("twice", x * 2);
}

public static object Run(bool c, int i)
{
    return $"{i} then {(Log("c", c) ? Twice(i) : 0)}";
}
=== several ?: in one statement keep their order
static int Sum(int a, int b, int c)
{
    return a * 100 + b * 10 + c;
}

public static object Run(bool c, bool d, int i)
{
    return Sum(Log("c", c) ? 1 : 2, Log("d", d) ? 3 : 4, Log("i", i));
}
=== a ?: inside a branch moves in front of that branch's store
static int Twice(int x)
{
    return Log("twice", x * 2);
}

public static object Run(bool c, bool d, int i)
{
    return Twice(Log("c", c) ? Twice(Log("d", d) ? i : 1) : Log("zero", 0));
}
=== a ?: in the condition and in a branch of one that moves
static int Twice(int x)
{
    return Log("twice", x * 2);
}

public static object Run(bool c, bool d, int i)
{
    return Twice(Twice(Log("d", d) ? i : 1) > 2 ? Log("i", i) : Log("c", c ? 1 : 0));
}
=== a throw branch with a ?: inside it
static int Twice(int x)
{
    return Log("twice", x * 2);
}

public static object Run(bool c, bool d, int i)
{
    return Twice(Log("c", c) ? i : throw new InvalidOperationException(Log("d", d) ? "first" : "second"));
}
=== an else-if chain in a hole
public static object Run(bool c, bool d, int i)
{
    return $"{(Log("c", c) ? "first" : Log("d", d) ? "second" : i > 0 ? "third" : "none")} {i}";
}
=== wire flags inside the cast that was around them
public static object Run(bool a, bool b, bool c)
{
    var bytes = new List<byte>();
    bytes.Add((byte)((Log("a", a) ? 1 : 0) | (Log("b", b) ? 2 : 0) | 4 | (Log("c", c) ? 0x80 : 0)));
    return bytes;
}
=== flags that start with another operand, in a long
public static object Run(bool a, bool b, long n)
{
    long f = Log("n", n) | (Log("a", a) ? 1L << 40 : 0L) | (Log("b", b) ? 1L : 0L);
    return f;
}
=== flags wider than the byte they are cut to
public static object Run(bool a, bool b, int i)
{
    return (byte)((Log("a", a) ? 0x100 : 0) | (Log("b", b) ? 0x81 : 0) | i);
}
=== an if condition
static int Twice(int x)
{
    return Log("twice", x * 2);
}

public static object Run(bool c, int i, int j)
{
    if (Twice(Log("c", c) ? i : j) > 4)
    {
        return Log("then", 1);
    }
    else if (Log("d", i) > j)
    {
        return 2;
    }
    return 3;
}
=== a foreach source
static List<int> Items(int count)
{
    var list = new List<int>();
    for (int k = 0; k < count && k < 5; k++)
    {
        list.Add(k);
    }
    return list;
}

public static object Run(bool c, int i)
{
    int sum = 0;
    foreach (var x in Items(Log("c", c) ? i : 2))
    {
        sum += Log("x", x);
    }
    return sum;
}
=== a switch, a throw and a return
static int Twice(int x)
{
    return Log("twice", x * 2);
}

public static object Run(bool c, int i)
{
    switch (Twice(Log("c", c) ? i : 1))
    {
        case 2:
            throw new ArgumentException(c ? "two" : "also two");
        case 4:
            return "four";
        default:
            return Log("other", c ? "yes" : "no");
    }
}
=== a yield return
static int Twice(int x)
{
    return Log("twice", x * 2);
}

public static IEnumerable<int> Run(bool c, int i)
{
    yield return Twice(Log("c", c) ? i : 1);
    yield return Log("after", i);
}
=== a using statement and a lock
public sealed class Res : IDisposable
{
    public int N;

    public Res(int n)
    {
        N = Log("open", n);
    }

    public void Dispose()
    {
        Log("close", N);
    }
}

static readonly List<int> s_gate = new List<int>();

static object Gate(object g)
{
    return g;
}

public static object Run(bool c, int i)
{
    int n;
    using (var r = new Res(Log("c", c) ? i : 0))
    {
        n = r.N;
    }
    lock (Gate(c ? s_gate : new List<int>()))
    {
        n++;
    }
    return n;
}
=== a declaration after a declarator that runs first
static int Twice(int x)
{
    return Log("twice", x * 2);
}

public static object Run(bool c, int i)
{
    int p = i, q = Twice(Log("c", c) ? i : 1);
    return (p, q);
}
=== a compound assignment reads its target first
static int Twice(int x)
{
    return Log("twice", x * 2);
}

public static object Run(bool c, int i)
{
    int x = i;
    x += Twice(Log("c", c) ? x : 1);
    return x;
}
=== an assignment inside an argument, an index and a tuple
static int Twice(int x)
{
    return Log("twice", x * 2);
}

public static object Run(bool c, int i)
{
    int y;
    var cells = new int[3];
    Twice(y = Log("c", c) ? i : 2);
    cells[c ? 0 : 2] = Log("y", y);
    var pair = (c ? i : -1, y);
    return (cells, pair);
}
=== a struct ?: as the receiver of a call that changes it
public struct Counter
{
    public int N;

    public int Next()
    {
        N++;
        return Log("n", N);
    }
}

public static object Run(bool c, int i)
{
    var a = new Counter { N = i };
    var b = new Counter { N = 7 };
    int r = (Log("c", c) ? a : b).Next();
    return (r, a.N, b.N);
}
=== a Unity object the ?: checks
static object Pair(int a, bool b)
{
    return (a, b);
}

public static object Run(bool c, UnityObject u)
{
    return Pair(u != null ? u.Hit() : -1, Log("c", c));
}
=== a string + with a plain left side
public static object Run(bool c, int i)
{
    return "n=" + i + (c ? "!" : "?");
}
=== a delegate in a local is read before the arguments
public static object Run(bool c, int i)
{
    Func<int, int> f = x => Log("f", x + 1);
    return f(Log("c", c) ? i : 0);
}
=== a getter that only reads a field is no call
public sealed class Holder
{
    readonly List<int> _items = new List<int>();

    public List<int> Items => _items;
}

public static object Run(bool c, int i)
{
    var h = new Holder();
    h.Items.Add(c ? i : 0);
    h.Items.Add(c ? 1 : i);
    return h.Items;
}
=== a statement of a block lambda moves inside the lambda
static int Twice(int x)
{
    return Log("twice", x * 2);
}

public static object Run(bool c, int i)
{
    Func<int> f = () =>
    {
        return Twice(Log("c", c) ? i : 1);
    };
    return f() + Log("after", i);
}
=== checked arithmetic in a branch stays checked
static int Twice(int x)
{
    return Log("twice", x * 2);
}

public static object Run(bool c, int i)
{
    checked
    {
        return Twice(Log("c", c) ? i + 1 : i - 1);
    }
}
=== a null starts the temporary, a converted null doesn't
static int? Same(int? x)
{
    return x;
}

static string Name(string x)
{
    return x;
}

public static object Run(bool c, int i)
{
    int? n = Same(Log("c", c) ? i : (int?)null);
    string s = Name(c ? "x" : null);
    return (n, s);
}
=== a method that reads the stack keeps its frames
static string Caller(int n)
{
    var frame = new System.Diagnostics.StackTrace(1, false).GetFrame(0);
    return frame.GetMethod().Name + n;
}

public static object Run(bool c)
{
    return Caller(c ? 1 : 2);
}
=== a field the ?: changes is read before it, so that ?: stays (hazard 8)
static int s_n = 10;

static int Bump()
{
    s_n = s_n * 10;
    return Log("bump", 1);
}

static object Pair(int a, int b)
{
    return (a, b);
}

public static object Run(bool c, int i)
{
    var kept = Pair(s_n, Log("c", c) ? Bump() : 0);
    var moved = Pair(i, c ? 2 : 3);
    return (kept, moved);
}
=== a call before the ?: changes what it reads, so that ?: stays (hazard 4)
static int s_n = 1;

static int Bump()
{
    s_n++;
    return Log("bump", s_n);
}

static object Pair(int a, int b)
{
    return (a, b);
}

public static object Run(bool c, int i)
{
    var kept = Pair(Bump(), c ? s_n : -1);
    var moved = Pair(i, c ? 2 : 3);
    return (kept, moved);
}
=== a read that throws for null stays in front of a call
public sealed class Box
{
    public readonly int Size = 4;
}

static int s_calls;

static int Bump()
{
    s_calls++;
    return Log("bump", s_calls);
}

static object Pair(int a, int b)
{
    return (a, b);
}

public static object Run(bool c, bool has, int i)
{
    Box b = null;
    if (has)
    {
        b = new Box();
    }
    var kept = Pair(b.Size, Log("c", c) ? Bump() : 0);
    var moved = Pair(i, c ? 2 : 3);
    return (kept, moved);
}
=== the mod's ToString makes an earlier hole into text, so that ?: stays
public sealed class Named
{
    public override string ToString()
    {
        return Log("named", "n" + s_calls);
    }
}

static int s_calls;

static int Bump()
{
    s_calls++;
    return Log("bump", s_calls);
}

public static object Run(bool c, int i)
{
    var named = new Named();
    var kept = $"{named} {(Log("c", c) ? Bump() : 0)}";
    var moved = $"{i} {(c ? 2 : 3)}";
    return (kept, moved);
}
=== a conversion of an earlier argument runs before the ?:, so that ?: stays
public struct Meters
{
    public int Value;

    public static implicit operator int(Meters m)
    {
        return Log("convert", m.Value + s_calls);
    }
}

static int s_calls;

static int Bump()
{
    s_calls++;
    return Log("bump", s_calls);
}

static object Pair(int a, int b)
{
    return (a, b);
}

public static object Run(bool c, int i)
{
    var m = new Meters { Value = i };
    var kept = Pair(m, Log("c", c) ? Bump() : 0);
    var moved = Pair(i, c ? 2 : 3);
    return (kept, moved);
}
=== the right of && may not run, so that ?: stays
static int Twice(int x)
{
    return Log("twice", x * 2);
}

public static object Run(bool c, bool d, int i)
{
    bool kept = Log("d", d) && Twice(Log("c", c) ? i : 1) > 2;
    var moved = Twice(c ? 2 : 3);
    return (kept, moved);
}
=== the right of || may not run, so that ?: stays
static int Twice(int x)
{
    return Log("twice", x * 2);
}

public static object Run(bool c, bool d, int i)
{
    bool kept = Log("d", d) || Twice(Log("c", c) ? i : 1) > 2;
    var moved = Twice(c ? 2 : 3);
    return (kept, moved);
}
=== the right of ?? may not run, so that ?: stays
static int? Maybe(bool d)
{
    if (Log("d", d))
    {
        return 5;
    }
    return null;
}

static int Twice(int x)
{
    return Log("twice", x * 2);
}

public static object Run(bool c, bool d, int i)
{
    int kept = Maybe(d) ?? Twice(Log("c", c) ? i : 1);
    var moved = Twice(c ? 2 : 3);
    return (kept, moved);
}
=== the part after ?. may not run, so that ?: stays
public class Bag
{
    public int Add(int x)
    {
        return Log("add", x);
    }
}

static Bag Find(bool d)
{
    if (Log("d", d))
    {
        return new Bag();
    }
    return null;
}

static int Twice(int x)
{
    return Log("twice", x * 2);
}

public static object Run(bool c, bool d, int i)
{
    int? kept = Find(d)?.Add(Log("c", c) ? i : 1);
    var moved = Twice(c ? 2 : 3);
    return (kept, moved);
}
=== a branch of another ?: may not run, so that ?: stays
static int Twice(int x)
{
    return Log("twice", x * 2);
}

public static object Run(bool c, bool d, int i)
{
    int kept = Log("d", d) ? Twice(Log("c", c) ? i : 1) : 0;
    var moved = Twice(c ? 2 : 3);
    return (kept, moved);
}
=== a lambda body runs at each call, so that ?: stays
static int Twice(int x)
{
    return Log("twice", x * 2);
}

public static object Run(bool c, int i)
{
    Func<int> f = () => Twice(Log("c", c) ? i : 1);
    var moved = Twice(c ? 2 : 3);
    return (f() + f(), moved);
}
=== a while condition runs each time round, so that ?: stays
static int Twice(int x)
{
    return Log("twice", x * 2);
}

public static object Run(bool c, int i)
{
    int n = 0;
    while (Twice(Log("c", c) ? n : i) < 6 && n < 5)
    {
        n++;
    }
    var moved = Twice(c ? 2 : 3);
    return (n, moved);
}
=== a for iterator runs each time round, so that ?: stays
static int Twice(int x)
{
    return Log("twice", x * 2);
}

public static object Run(bool c, int i)
{
    int n = 0;
    for (int k = 0; k < 6; k += Twice(Log("c", c) ? 1 : 2))
    {
        n += Log("k", k);
    }
    var moved = Twice(c ? i : 3);
    return (n, moved);
}
