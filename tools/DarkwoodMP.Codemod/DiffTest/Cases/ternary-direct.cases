=== declaration with both values
public static object Run(bool c, int a, int b)
{
    int x = Log("c", c) ? Log("a", a) : Log("b", b);
    return x;
}
=== declaration that starts with its literal
public static object Run(bool c, string s)
{
    string t = Log("c", c) ? Log("s", s) : null;
    var n = Log("d", !c) ? Log("len", t.Length) : -1;
    return (t, n);
}
=== var spelled out with the natural type double
public static object Run(bool c, int i)
{
    var x = Log("c", c) ? Log("i", i) : 2.5;
    return x;
}
=== else-if chain with a literal last
public static object Run(bool c, bool d, int i)
{
    var x = Log("c", c) ? Log("i", i) : Log("d", d) ? Log("two", 2) : -1;
    return x;
}
=== a ?: nested in the true branch
public static object Run(bool c, bool d, string s)
{
    string x = Log("c", c) ? (Log("d", d) ? Log("s", s) : "d") : Log("e", "e");
    return x;
}
=== a return chain ending in a throw
public static object Run(bool c, bool d, int i)
{
    return Log("c", c) ? Log("i", i)
        : Log("d", d) ? Log("two", 2)
        : throw new InvalidOperationException("no " + i);
}
=== a return nested in the true branch
public static object Run(bool c, bool d, int i)
{
    return Log("c", c) ? (Log("d", d) ? Log("i", i) : -i) : Log("zero", 0);
}
=== assignments to a local and a static field
static int s_field;

public static object Run(bool c, int i)
{
    int x;
    x = Log("c", c) ? Log("i", i) : Log("zero", 0);
    s_field = Log("d", !c) ? Log("x", x) : Log("one", 1);
    return x;
}
=== a member of a parameter, with a condition that has effects
public static object Run(bool c, UnityObject u, int i)
{
    u.Count = Log("c", c) ? Log("i", i) : Log("seven", 7);
    return u;
}
=== an element of a local array
public static object Run(bool c, int i)
{
    var cells = new int[3];
    cells[i] = Log("c", c) ? Log("one", 1) : Log("two", 2);
    return cells;
}
=== a string key written in each branch
public static object Run(bool c, bool d, int i)
{
    var map = new Dictionary<string, int>();
    map["key"] = Log("c", c) ? Log("i", i) : Log("d", d) ? 2 : 3;
    return map["key"];
}
=== a compound assignment with plain operands
public static object Run(bool c, int n, int a)
{
    int x = n;
    x += c ? a : 2;
    return x;
}
=== a compound assignment keeps the natural type long
public static object Run(bool c, int i, long n)
{
    long sum = n;
    sum += c ? i : 2L;
    return sum;
}
=== an expression-bodied property, method and local function
static int s_x;

static int Value => Log("x", s_x) > 0 ? Log("pos", s_x) : Log("zero", 0);

static string Sign(int i) => Log("i", i) > 0 ? "plus" : i < 0 ? "minus" : "zero";

public static object Run(bool c, int i)
{
    s_x = i;
    int Pick(int a, int b) => Log("c", c) ? a : b;
    return (Value, Sign(i), Pick(i, 3));
}
=== an indexer and accessors of a class
public sealed class Grid
{
    public int[] Cells = new int[2];

    public int this[int i] => i >= 0 && i < 2 ? Log("cell", Cells[i]) : -1;

    public int First
    {
        get => Cells[0] > 0 ? Cells[0] : 0;
        set => Cells[0] = Log("v", value) > 0 ? value : 0;
    }
}

public static object Run(int i, int v)
{
    var g = new Grid();
    g.First = v;
    return (g[i], g.First, g);
}
=== a lambda body and an Action body
static int s_n;

public static object Run(int i)
{
    Func<int, string> name = x => Log("x", x) > 0 ? "plus" : "minus";
    Action<int> store = x => s_n = Log("y", x) > 0 ? x : 0;
    store(i);
    return name(i);
}
=== a lambda inside a rewritten branch
public static object Run(bool c, int i)
{
    var list = new List<int> { i, 1, -1 };
    var picked = Log("c", c)
        ? System.Linq.Enumerable.ToList(
            System.Linq.Enumerable.Select(list, x => Log("x", x) > 0 ? x : 0))
        : null;
    return picked;
}
=== an if condition
public static object Run(bool c, int a, int b)
{
    int n;
    if (Log("c", c) ? Log("a", a) > 0 : Log("b", b) > 0)
    {
        n = Log("then", 1);
    }
    else
    {
        n = Log("else", 2);
    }
    return n;
}
=== an if condition with a rewritten statement in its body
public static object Run(bool c, int i)
{
    if (Log("c", c) ? i > 0 : false)
    {
        var sign = Log("i", i) > 1 ? 1 : -1;
        return sign;
    }
    return 0;
}
=== a foreach source
public static object Run(bool c, int i)
{
    var a = new List<int> { i, 1 };
    var b = new List<int> { 2 };
    int sum = 0;
    foreach (var x in Log("c", c) ? a : b)
    {
        sum += Log("x", x);
    }
    return sum;
}
=== a double boxed where the target is object (hazard 1)
public static object Run(bool c)
{
    object o = Log("c", c) ? 1 : 2.0;
    return o;
}
=== a negative literal and default keep the natural type
public static object Run(bool c, int i)
{
    object neg = Log("c", c) ? -1 : 2.5;
    object zero = Log("d", !c) ? Log("i", i) : default;
    object none = Log("e", c) ? Log("s", "s") : null;
    return (neg, zero, none);
}
=== a return and a lambda of type object
static object Mixed(bool c)
{
    return Log("m", c) ? 1 : 2.5;
}

public static object Run(bool c)
{
    Func<object> f = () => Log("c", c) ? 1 : 2.5;
    return (Mixed(c), f());
}
=== an async return of type object
public static async System.Threading.Tasks.Task<object> Run(bool c)
{
    await System.Threading.Tasks.Task.Yield();
    return Log("c", c) ? 1 : 2.5;
}
=== a pattern variable in the condition
public static object Run(object o)
{
    var n = o is string s ? Log("s", s).Length : -1;
    return n;
}
=== a variable declared in a branch and used only there
public static object Run(bool c, string t)
{
    var n = Log("c", c) ? (int.TryParse(Log("t", t), out var v) ? v : -2) : -1;
    return n;
}
=== a method that reads the stack keeps its frames
static string Caller()
{
    var frame = new System.Diagnostics.StackTrace(1, false).GetFrame(0);
    return frame != null ? frame.GetMethod().Name : "none";
}

public static object Run(bool c)
{
    Func<string> f = () => Log("c", c) ? Caller() : "skipped";
    return f();
}
=== a compound assignment where the natural type changes the result
public static object Run(bool c)
{
    string s = "x";
    s += c ? 1 : 'a';
    return s;
}
=== a user-defined conversion runs on every path
public sealed class Token
{
    public string Kind;

    public static implicit operator Token(string s)
    {
        var t = new Token();
        t.Kind = "a string";
        if (s == null)
        {
            t.Kind = "a null string";
        }
        return t;
    }
}

public sealed class Holder
{
    public Token Stored;

    public Token this[string key]
    {
        get => Stored;
        set => Stored = value;
    }
}

public static Token Make(bool c, string s) => Log("c", c) ? s : null;

public static object Run(bool c, string s)
{
    var h = new Holder();
    h["k"] = Log("c", c) ? s : null;
    Token t = Log("d", !c) ? s : null;
    return (h.Stored, t, Make(c, s));
}
=== a minus and a number in a compound assignment turn the operator round
public static object Run(bool c, int n, double d)
{
    int x = n;
    x += c ? 1 : -1;
    int y = n;
    y -= !c ? -2 : 3;
    double z = d;
    z += c ? 0.5 : -0.0;
    checked
    {
        int w = n;
        w += c ? 2 : -1;
        return (x, y, z, w);
    }
}
=== a tuple with element names needs no cast
public static (long Got, long Total)? Progress(bool c, long a, int b) =>
    Log("c", c) ? ((long, long)?)null : (Log("a", a), Log("b", b));

public static object Run(bool c, long a, int b)
{
    return Progress(c, a, b);
}
