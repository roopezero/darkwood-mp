        a = new Box { N = n };
    }
    int? count = a?.Count, extra = Bump(n);
    return count;
}
=== a using declaration still disposes what the ?. opened
public class Res : System.IDisposable
{
    public int N;

    public void Dispose()
    {
        Log("dispose", N);
    }
}

public class Box
{
    public int N;

    public Res Open()
    {
        return new Res { N = Log("open", N) };
    }
}

public static object Run(bool has, int n)
{
    Box a = null;
    if (has)
    {
        a = new Box { N = n };
    }
    using Res r = a?.Open();
    Log("body", n);
    return n;
}
=== a chain tests each value once, in order
public class Box
{
    public int N;
    public Box Inner;

    public Box Next
    {
        get
        {
            Log("next", N);
            return Inner;
        }
    }

    public string Name => Log("name", "b" + N);

    public void Hit()
    {
        Log("hit", N);
    }
}

public static object Run(bool first, bool second, bool third)
{
    Box a = null;
    if (first)
    {
        a = new Box { N = 1 };
        if (second)
        {
            a.Inner = new Box { N = 2 };
            if (third)
            {
                a.Inner.Inner = new Box { N = 3 };
            }
        }
    }
    var name = a?.Next?.Next?.Name;
    a?.Next?.Next?.Hit();
    return name;
}
=== an assignment sets its target once, with the final value
public class Box
{
    public int N;

    public string Name => Log("name", "b" + N);
}

static string s_set;

static string Target
{
    get
    {
        return s_set;
    }
    set
    {
        Log("set", value);
        s_set = value;
    }
}

public static object Run(bool has, string start)
{
    s_set = start;
    Box a = null;
    if (has)
    {
        a = new Box { N = 4 };
    }
    Target = a?.Name;
    string local = start;
    local = a?.Name;
    return (s_set, local);
}
=== a return, expression bodies and lambdas
public class Box
{
    public int N;
    public Box Inner;

    public string Name => Log("name", "b" + N);

    public void Hit()
    {
        Log("hit", N);
    }
}

static Box s_box;

static string Label => s_box?.Inner?.Name;

static int Count => s_box?.Inner?.N ?? -1;

static object Boxed => s_box?.N;

static void Hit() => s_box?.Hit();

static string Find(Box a)
{
    return a?.Inner?.Name;
}

public static object Run(bool has, bool inner)
{
    s_box = null;
    if (has)
    {
        s_box = new Box { N = 1 };
        if (inner)
        {
            s_box.Inner = new Box { N = 2 };
        }
    }
    Hit();
    Func<Box, string> name = b => b?.Name;
    Action<Box> hit = b => b?.Hit();
    hit(s_box);
    Func<Box, string> both = b => b?.Name + "/" + b?.Inner?.Name;
    return (Label, Count, Boxed is int, Find(s_box), name(s_box), both(s_box));
}
=== comparisons keep the original's result for a null receiver
public class Box
{
    public int N;
    public bool Open;
    public string Label;
    public int? Size;
}

public static object Run(bool has, int n, bool open)
{
    Box a = null;
    if (has)
    {
        a = new Box { N = n, Open = open, Label = "x" + n };
        if (open)
        {
            a.Size = n;
        }
    }
    var results = new List<bool>();
    results.Add(a?.N == 5);
    results.Add(a?.N != 5);
    results.Add(a?.N > 2);
    results.Add(a?.N <= 2);
    results.Add(5 == a?.N);
    results.Add(a?.N != n);
    results.Add(a?.Label == null);
    results.Add(a?.Label != null);
    results.Add(a?.Label == "x5");
    results.Add(a?.Size == null);
    results.Add(a?.Size >= 3);
    results.Add(a?.Open == true);
    results.Add(a?.Open != true);
    results.Add(a?.Open == false);
    results.Add(a?.Open != false);
    results.Add(true != a?.Open);
    results.Add(a?.Open ?? false);
    results.Add(a?.Open ?? true);
    results.Add(!(a?.N == 1) || a?.N == 2);
    results.Add(open && a?.N == 3);
    results.Add(a?.N == 4 ? open : !open);
    return results;
}
=== a comparison in a loop condition stays one expression
public class Box
{
    public int N;
    public Box Next;
}

public static object Run(bool first, bool second)
{
    Box a = null;
    if (first)
    {
        a = new Box { N = 1 };
        if (second)
        {
            a.Next = new Box { N = 2 };
        }
    }
    int steps = 0;
    while (a?.Next != null)
    {
        a = a.Next;
        steps++;
    }
    return (steps, a?.N);
}
=== a compared value with effects or a null runs and compares as before
public class Box
{
    public int N;
}

static int Next(int k)
{
    return Log("next", k);
}

public static object Run(bool has, int? m)
{
    Box a = null;
    if (has)
    {
        a = new Box { N = 3 };
    }
    bool same = a?.N == Next(3);
    bool nullable = a?.N == m;
    bool none = a?.N == null;
    bool after = Next(4) > a?.N;
    return (same, nullable, none, after);
}
=== a receiver that is a static field is read once into a temporary
public class Box
{
    public int N;
}

static Box s_box;

public static object Run(bool has, int n)
{
    s_box = null;
    if (has)
    {
        s_box = new Box { N = n };
