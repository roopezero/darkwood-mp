=== a statement runs its arguments only for a receiver that isn't null
public class Box
{
    public int N;

    public void Hit(int k)
    {
        Log("hit", k);
        N += 1;
    }
}

public static object Run(bool has, int k)
{
    Box a = null;
    if (has)
    {
        a = new Box { N = 2 };
    }
    a?.Hit(Log("k", k));
    return a;
}
=== a receiver that is a property is read once
public class Box
{
    public int N;

    public void Hit(int k)
    {
        Log("hit", k);
    }
}

static int s_reads;
static bool s_has;

static Box Current
{
    get
    {
        s_reads++;
        Log("read", s_reads);
        if (s_has && s_reads == 1)
        {
            return new Box { N = 1 };
        }
        return null;
    }
}

public static object Run(bool has, bool more)
{
    s_reads = 0;
    s_has = has;
    Current?.Hit(1);
    s_reads = 0;
    var seen = Current?.N;
    s_reads = 0;
    if (Current?.N == 1)
    {
        Log("one", more);
    }
    return seen;
}
=== an event and a delegate field go through a local and are called
static event Action<int> Changed;
static Func<int, int> s_twice;

public static object Run(bool subscribed, int n)
{
    Changed = null;
    s_twice = null;
    if (subscribed)
    {
        Changed += k => Log("handled", k);
        s_twice = k => Log("twice", k * 2);
    }
    Changed?.Invoke(Log("n", n));
    var doubled = s_twice?.Invoke(n);
    Changed = null;
    s_twice = null;
    return doubled;
}
=== a delegate local is called only when it isn't null
public static object Run(bool has, int n)
{
    Action<int> done = null;
    Func<int, int> twice = null;
    if (has)
    {
        done = k => Log("done", k);
        twice = k => k * 2;
    }
    done?.Invoke(Log("n", n));
    var doubled = twice?.Invoke(n);
    return doubled;
}
=== declarations keep the natural type, a Nullable for a value type
public class Box
{
    public int N;

    public string Name => Log("name", "b" + N);

    public int Count => Log("count", N);
}

public static object Run(bool has, int n)
{
    Box a = null;
    if (has)
    {
        a = new Box { N = n };
    }
    var name = a?.Name;
    var count = a?.Count;
    long? wide = a?.Count;
    object boxed = a?.Count;
    return (name, count, wide, boxed is int, boxed is long);
}
