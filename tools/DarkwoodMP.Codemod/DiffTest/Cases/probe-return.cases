=== literal branches
public static object Run(bool c)
{
    return Log("c", c) ? Log("a", 1) : Log("b", 2);
}
=== strings and nulls
public static object Run(bool c, string s)
{
    return Log("c", c) ? Log("a", s) : Log("b", "other");
}
=== unity object branches
public static object Run(bool c, UnityObject u)
{
    return Log("c", c) ? Log("a", u) : Log("b", (UnityObject)null);
}
=== numbers and a nested operand
public static object Run(int n, double d)
{
    return Log("gt", Log("n", n) > 0) ? Log("x", d * 2) : Log("y", d - n);
}
