=== a statement runs its arguments only for a receiver that is alive
public static object Run(UnityObject u, int k)
{
    u?.Take(Log("k", k));
    return k;
}
=== a receiver that is a property is read once
static int s_reads;
static UnityObject s_object;

static UnityObject Current
{
    get
    {
        s_reads++;
        Log("read", s_reads);
        if (s_reads == 1)
        {
            return s_object;
        }
        return null;
    }
}

public static object Run(UnityObject u)
{
    s_object = u;
    s_reads = 0;
    Current?.Take(1);
    s_reads = 0;
    var seen = Current?.Count;
    s_object = null;
    return seen;
}
=== a receiver that is a call is read once
static UnityObject s_object;

static UnityObject Get()
{
    Log("get", s_object);
    return s_object;
}

public static object Run(UnityObject u)
{
    s_object = u;
    Get()?.Take(2);
    var next = Get()?.Next;
    s_object = null;
    return next;
}
=== a delegate after a Unity receiver is called through its temporary
public static object Run(UnityObject u, bool listen)
{
    // A destroyed object gets a listener too, so the original calls it.
    if ((object)u != null && listen)
    {
        u.Heard = x => Log("heard", x);
    }
    u?.Heard?.Invoke(Log("k", 4));
    return listen;
}
=== a declaration keeps its natural type
public static object Run(UnityObject u)
{
    var n = u?.Count;
    var next = u?.Next;
    object boxed = u?.Count;
    return (n, next, boxed, boxed?.GetType().Name);
}
=== a chain tests each Unity value with Unity's check
public static object Run(UnityObject u)
{
    u?.Next?.Take(Log("k", 5));
    var count = u?.Next?.Count;
    return count;
}
=== a plain receiver keeps the reference check and its Unity member gets Unity's
public class Box
{
    public UnityObject U;
}

public static object Run(UnityObject u, bool has)
{
    Box box = null;
    if (has)
    {
        box = new Box { U = u };
    }
    box?.U?.Take(Log("k", 6));
    var seen = box?.U?.Count;
    return seen;
}
=== an assignment writes the target once
static int s_sets;
static UnityObject s_stored;

static UnityObject Stored
{
    get
    {
        return s_stored;
    }
    set
    {
        s_sets++;
        Log("set", value);
        s_stored = value;
    }
}

public static object Run(UnityObject u)
{
    s_sets = 0;
    s_stored = null;
    Stored = u?.Next;
    int? n = 9;
    n = u?.Count;
    return (s_sets, n);
}
=== a return gives null for a receiver that isn't alive
public static object Run(UnityObject u, bool deep)
{
    if (deep)
    {
        return u?.Next?.Hit();
    }
    return u?.Hit();
}
=== an expression body and a lambda get a block
static int Count(UnityObject u) => u?.Hit() ?? -1;

static UnityObject Next(UnityObject u) => u?.Next;

public static object Run(UnityObject u)
{
    Func<UnityObject, int?> hit = x => x?.Hit();
    return (Count(u), Next(u), hit(u));
}
=== an argument and an interpolation hole move into a temporary
static string Show(int? n)
{
    Log("show", n);
    return n.ToString();
}

public static object Run(UnityObject u, int k)
{
    var a = Show(u?.Count);
    var b = $"at {k} {u?.Count} of {u?.Next?.Count}";
    return (a, b);
}
=== the comparisons keep their place
public static object Run(UnityObject u, int k)
{
    bool a = u?.Count == 13;
    bool b = u?.Count != 13;
    bool c = u?.Count > k;
    bool d = u?.Next == null;
    bool e = u?.Next != null;
    bool f = u?.Big == true;
    bool g = u?.Big != true;
    bool h = u?.Big == false;
    bool i = u?.Big != false;
    bool j = u?.Big ?? false;
    bool l = u?.Big ?? true;
    bool m = k > 0 && u?.Count == 13;
    return (a, b, c, d, e, f, g, h, i, j, l, m);
}
=== a comparison in a loop condition
public static object Run(UnityObject u)
{
    int turns = 0;
    while (u?.Count > 10 && turns < 4)
    {
        u.Take(-1);
        turns++;
        Log("turn", turns);
    }
    return turns;
}
=== a compared value with effects still runs, and a null one still compares
static int Five()
{
    Log("five", 5);
    return 5;
}

public static object Run(UnityObject u, UnityObject v)
{
    bool a = u?.Count == Five();
    bool b = u?.Next == v;
    return (a, b);
}
=== a ?? gives the next value for a destroyed one
public static object Run(UnityObject a, [PassesThrough] UnityObject b)
{
    UnityObject x = Log("a", a) ?? Log("b", b);
    var y = a ?? b;
    return (x, y);
}
=== a chain of ?? tests every value but the last
public static object Run(
    UnityObject a, UnityObject b, [PassesThrough] UnityObject c)
{
    var x = Log("a", a) ?? Log("b", b) ?? Log("c", c);
    return x;
}
=== a ?? stored to a field, returned and passed on
static UnityObject s_field;

static UnityObject Pick(UnityObject a, UnityObject b)
{
    return a ?? b;
}

static UnityObject Use(UnityObject value)
{
    Log("use", value);
    return value;
}

public static object Run(UnityObject a, [PassesThrough] UnityObject b)
{
    s_field = null;
    s_field = a ?? Log("b", b);
    var picked = Pick(a, b);
    var used = Use(a ?? b);
    return (s_field, picked, used);
}
=== a local that is the temporary of its ??
public static object Run(UnityObject a, [PassesThrough] UnityObject b)
{
    UnityObject x = null;
    Log("x", x);
    x = a ?? b;
    return x;
}
=== a ?. in the first value is opened with its ??
public static object Run(UnityObject a, [PassesThrough] UnityObject b)
{
    var x = a?.Next ?? b;
    var n = a?.Next?.Count;
    return (x, n);
}
=== a ?. that a ?? opens reads a receiver that is a call once
static UnityObject s_object;
static UnityObject s_field;
static int s_gets;

static UnityObject Get()
{
    s_gets++;
    return Log("get", s_object);
}

static UnityObject Back(UnityObject b)
{
    return Get()?.Next ?? b;
}

public static object Run(UnityObject u, [PassesThrough] UnityObject b)
{
    s_object = u;
    s_field = null;
    s_gets = 0;
    var x = Get()?.Next ?? b;
    s_field = Get()?.Next ?? b;
    var y = Back(b);
    int n = Get()?.Count ?? -1;
    s_object = null;
    return (x, s_field, y, n, s_gets);
}
=== ??= replaces a destroyed value
static UnityObject s_cache;

static UnityObject Make()
{
    Log("make", 1);
    return null;
}

public static object Run(UnityObject a, [PassesThrough] UnityObject b)
{
    s_cache = a;
    s_cache ??= b;
    var local = a;
    local ??= Make();
    return (s_cache, local);
}
=== ??= used as a value is read once and written once
static UnityObject s_cache;
static int s_reads;

static UnityObject Cache
{
    get
    {
        s_reads++;
        Log("read", s_reads);
        return s_cache;
    }
    set
    {
        Log("set", value);
        s_cache = value;
    }
}

public static object Run(UnityObject a, [PassesThrough] UnityObject b)
{
    s_cache = a;
    s_reads = 0;
    var got = (Cache ??= b).Hit();
    return (got, s_cache, s_reads);
}
=== x?.Count != 5 is true for a receiver that isn't alive
public static object Run(UnityObject u)
{
    bool a = u?.Count != 5;
    bool b = u?.Count != 10;
    return (a, b);
}
=== a site after a call stays, and the one before it is rewritten
static int s_calls;
static UnityObject s_made;

// It changes the object the second site reads, so reading it before the
// call would show.
static int Bump()
{
    s_calls++;
    Log("bump", s_calls);
    if (s_made != null)
    {
        s_made.Count += 100;
    }
    return s_calls;
}

static object Two(int a, int? b)
{
    return (a, b);
}

public static object Run(UnityObject u, bool make)
{
    s_calls = 0;
    s_made = null;
    if (make)
    {
        s_made = new UnityObject();
    }
    var first = u?.Count;
    var pair = Two(Bump(), s_made?.Count);
    s_made = null;
    return (first, pair);
}
=== a site that may not run stays, and one that always runs is rewritten
static bool Check(int? n)
{
    Log("check", n);
    return n > 0;
}

public static object Run(UnityObject u, bool flag)
{
    UnityObject made = null;
    if (flag)
    {
        made = new UnityObject();
    }
    var always = u?.Hit();
    bool sometimes = flag && Check(made?.Count);
    string branch = "none";
    if (flag)
    {
        branch = u?.Next?.Count.ToString();
    }
    return (always, sometimes, branch);
}
=== a ?? of a type that isn't a Unity type stays, and the next one is rewritten
public static object Run(
    UnityObject a, [PassesThrough] UnityObject b, bool make)
{
    UnityObject made = null;
    if (make)
    {
        made = new UnityObject();
    }
    object o = Log("made", made) ?? (object)"x";
    var x = a ?? b;
    return (o, x);
}
=== a ?. inside a ?? and a ?? inside a ?. stay, and the next site is rewritten
public static object Run(UnityObject a, bool make)
{
    UnityObject one = null;
    UnityObject two = null;
    if (make)
    {
        one = new UnityObject();
        two = new UnityObject { Count = 7, Next = new UnityObject() };
    }
    var x = one ?? two?.Next;
    one?.Take((one ?? two).Count);
    var y = a?.Next;
    return (x, y, one?.Count);
}
