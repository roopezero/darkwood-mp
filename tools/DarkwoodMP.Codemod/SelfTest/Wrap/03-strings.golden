=== input
using System;

class Strings
{
    const string Joined = "a constant string that is long enough to be split at one of its spaces";

    static string Pick(string key)
    {
        switch (key)
        {
            case "a case label that is far too long for the line but can never be split here":
                return "x";
        }
        var parts = "a receiver string, long enough that it is split, with Split after it".Split(',');
        var path = @"C:\a verbatim string\that is long enough\to cross the limit\and is never split.txt";
        var raw = """a raw string that is long enough to cross the limit and is never split at all""";
        var shown = $"an interpolated string {key} that is long enough to cross the limit, for stage 11";
        var bytes = "a UTF-8 string that is long enough to cross the limit and is never split"u8.ToArray();
        var escaped = "an escape\\ before a space and a quote \" in a string long enough to be split";
        Console.WriteLine("a log line with a plain string constant that runs on past the limit");
        return parts[0] + path + raw + shown + bytes.Length + escaped;
    }
}
=== wrap
using System;

class Strings
{
    const string Joined =
        "a constant string that is long enough to be split at one of its "
            + "spaces";

    static string Pick(string key)
    {
        switch (key)
        {
            case "a case label that is far too long for the line but can never be split here":
                return "x";
        }
        var parts =
            ("a receiver string, long enough that it is split, with Split "
                + "after it").Split(',');
        var path =
            @"C:\a verbatim string\that is long enough\to cross the limit\and is never split.txt";
        var raw =
            """a raw string that is long enough to cross the limit and is never split at all""";
        var shown =
            $"an interpolated string {key} that is long enough to cross the limit, for stage 11";
        var bytes =
            "a UTF-8 string that is long enough to cross the limit and is never split"u8.ToArray();
        var escaped =
            "an escape\\ before a space and a quote \" in a string long enough "
                + "to be split";
        Console.WriteLine(
            "a log line with a plain string constant that runs on past the "
                + "limit");
        return parts[0] + path + raw + shown + bytes.Length + escaped;
    }
}
=== report
13: a string in a pattern or a case label
20: a verbatim or raw string, never split
22: a verbatim or raw string, never split
24: an interpolated string (stage 11)
26: a UTF-8 string, never split
