=== input
class Comments
{
    // A paragraph of plain prose whose first line runs on well past the eighty column limit of the repo
    // and whose second line is short.
    //
    // A second paragraph, after an empty line, stays while it fits.
    int A;

    /// <summary>A one-line summary that is far too long for the line it is written on, so it opens.</summary>
    int B;

    /// <summary>
    /// Doc prose inside a summary, long enough to be reflowed with <see cref="Comments"/> kept whole.
    /// </summary>
    /// <param name="x">A parameter's text starts its own paragraph and never joins the summary above it.</param>
    void C(int x)
    {
    }

    // Lists keep their lines:
    // - a list item that is long enough to go past the limit stays exactly as it was written here
    // 1. so does a numbered one, however long it gets, because its line break carries the list's shape
    // | a table row | with cells | that runs on past the limit of eighty columns | stays |
    //     indented code or a diagram inside a comment stays where it is, too, even this long
    // commentedOut.Call(first, second, third, fourth, fifth, sixth, seventh, eighth);
    // See https://example.com/a/very/long/address/that/has/no/space/in/it/anywhere/at/all/here
    int D;

    // ---------------------------------------------------------------------------------------------
    // ---- a heading ---------------------------------------------------------------------------------
    int E;

    void F(int a)
    {
        a = a + 1; // a trailing comment behind short code that takes the line past the limit
    }
}
=== wrap
class Comments
{
    // A paragraph of plain prose whose first line runs on well past the eighty
    // column limit of the repo and whose second line is short.
    //
    // A second paragraph, after an empty line, stays while it fits.
    int A;

    /// <summary>
    /// A one-line summary that is far too long for the line it is written on,
    /// so it opens.
    /// </summary>
    int B;

    /// <summary>
    /// Doc prose inside a summary, long enough to be reflowed with
    /// <see cref="Comments"/> kept whole.
    /// </summary>
    /// <param name="x">A parameter's text starts its own paragraph and never
    /// joins the summary above it.</param>
    void C(int x)
    {
    }

    // Lists keep their lines:
    // - a list item that is long enough to go past the limit stays exactly as it was written here
    // 1. so does a numbered one, however long it gets, because its line break carries the list's shape
    // | a table row | with cells | that runs on past the limit of eighty columns | stays |
    //     indented code or a diagram inside a comment stays where it is, too, even this long
    // commentedOut.Call(first, second, third, fourth, fifth, sixth, seventh, eighth);
    // See
    // https://example.com/a/very/long/address/that/has/no/space/in/it/anywhere/at/all/here
    int D;

    // -------------------------------------------------------------------------
    // ---- a heading ----------------------------------------------------------
    int E;

    void F(int a)
    {
        // a trailing comment behind short code that takes the line past the
        // limit
        a = a + 1;
    }
}
