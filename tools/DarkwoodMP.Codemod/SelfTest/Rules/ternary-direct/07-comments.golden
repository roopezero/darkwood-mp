Comments behind a rewritten statement. One that starts with the text of a
branch and a colon explains that branch, so it goes behind the statement
that holds that value, also when a declaration starts with it. Any other
explains the whole statement and goes on a line of its own above the new
code: behind the first if it would read as a note on the condition and the
first branch, behind a bare declaration as a note on nothing. A member's
comment stays on its header's line, unless it explains a branch.
=== input
namespace N
{
    public class C
    {
        int _n;

        public int Count => _n > 0 ? _n : 0; // never below zero

        public string Name => _n > 0 ? "some" : null; // null: none yet

        int Twice(int i) => i > 0 ? i * 2 : -1; // -1: no value

        public string Rewritten(bool c, string s, int i)
        {
            var w = c ? 1 : 2; // explains the whole value
            string t = c ? s : null; // null: no name given
            string u = c ? s : "x"; // "x": a name that says none was given
            _n = c ? i : 0; // keeps the count
            _n += c ? 1 : 2; /* why */ // and more
            if (i > 0)
            {
                return c ? s : null; // null: the caller asks again
            }
            return i > 1 ? t : i > 2 ? u : s; // either name
        }
    }
}
=== output
namespace N
{
    public class C
    {
        int _n;

        public int Count // never below zero
        {
            get
            {
                if (_n > 0)
                {
                    return _n;
                }
                return 0;
            }
        }

        public string Name
        {
            get
            {
                if (_n > 0)
                {
                    return "some";
                }
                return null; // null: none yet
            }
        }

        int Twice(int i)
        {
            if (i > 0)
            {
                return i * 2;
            }
            return -1; // -1: no value
        }

        public string Rewritten(bool c, string s, int i)
        {
            // explains the whole value
            int w = 2;
            if (c)
            {
                w = 1;
            }
            string t = null; // null: no name given
            if (c)
            {
                t = s;
            }
            string u = "x"; // "x": a name that says none was given
            if (c)
            {
                u = s;
            }
            // keeps the count
            if (c)
            {
                _n = i;
            }
            else
            {
                _n = 0;
            }
            /* why */ // and more
            if (c)
            {
                _n += 1;
            }
            else
            {
                _n += 2;
            }
            if (i > 0)
            {
                if (c)
                {
                    return s;
                }
                return null; // null: the caller asks again
            }
            // either name
            if (i > 1)
            {
                return t;
            }
            if (i > 2)
            {
                return u;
            }
            return s;
        }
    }
}
=== queue
