Conditions. An if condition or a foreach source gets a temporary of the
natural type in front of its statement: it is the first thing the
statement runs, so no order changes. A foreach source that declares a
variable would widen its scope; an else-if, a loop or for condition and a
switch expression arm need restructuring. All of those go to the queue.
=== input
using System;
using System.Collections.Generic;

namespace N
{
    public class C
    {
        public int Conditions(bool c, int i, List<int> a, List<int> b, object o)
        {
            int n = 0;
            if (c ? a.Count > 0 : b.Count > 0)
            {
                n++;
            }
            else
            {
                n--;
            }
            if (i > 0 ? c : false)
            {
                n++;
            }
            foreach (var x in c ? a : b)
            {
                n += x;
            }
            foreach (var x in o is List<int> l ? l : a)
            {
                n += x;
            }
            if (n > 0)
            {
                n++;
            }
            else if (c ? n > 1 : n < -1)
            {
                n--;
            }
            while (c ? n < 10 : n < 5)
            {
                n++;
            }
            for (int k = 0; k < (c ? 2 : 3); k++)
            {
                n++;
            }
            return i switch
            {
                0 => c ? 1 : 2,
                _ => n,
            };
        }
    }
}
=== output
using System;
using System.Collections.Generic;

namespace N
{
    public class C
    {
        public int Conditions(bool c, int i, List<int> a, List<int> b, object o)
        {
            int n = 0;
            bool condition;
            if (c)
            {
                condition = a.Count > 0;
            }
            else
            {
                condition = b.Count > 0;
            }
            if (condition)
            {
                n++;
            }
            else
            {
                n--;
            }
            bool condition2 = false;
            if (i > 0)
            {
                condition2 = c;
            }
            if (condition2)
            {
                n++;
            }
            List<int> items;
            if (c)
            {
                items = a;
            }
            else
            {
                items = b;
            }
            foreach (var x in items)
            {
                n += x;
            }
            foreach (var x in o is List<int> l ? l : a)
            {
                n += x;
            }
            if (n > 0)
            {
                n++;
            }
            else if (c ? n > 1 : n < -1)
            {
                n--;
            }
            while (c ? n < 10 : n < 5)
            {
                n++;
            }
            for (int k = 0; k < (c ? 2 : 3); k++)
            {
                n++;
            }
            return i switch
            {
                0 => c ? 1 : 2,
                _ => n,
            };
        }
    }
}
=== queue
27: the source declares a variable, whose scope would change
35: an else-if condition: needs restructuring
39: a loop condition: needs restructuring
49: a switch expression arm: needs a switch statement
