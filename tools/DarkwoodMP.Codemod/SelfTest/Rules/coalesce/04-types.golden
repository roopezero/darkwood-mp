The types decide. A Unity object on the left stays for stage 7 and is not
queued; a ?. on a Unity receiver stays as written while the ?? around it
is rewritten, and so does a ?. of two links. A type with an == of its own
goes to the queue, and so does dynamic, a left side that converts to the
type of the ?? by a user-defined conversion, and a chain whose first value
would have to be unwrapped. A value of a derived type fills a temporary of
the base type, and a Nullable of another type fills one by a nullable
conversion.
=== input
namespace UnityEngine
{
    public class Object
    {
    }

    public class Component : Object
    {
        public string tag;
    }
}

namespace N
{
    public class Money
    {
        public static bool operator ==(Money a, Money b)
        {
            return ReferenceEquals(a, b);
        }

        public static bool operator !=(Money a, Money b)
        {
            return !ReferenceEquals(a, b);
        }

        public override bool Equals(object o)
        {
            return ReferenceEquals(this, o);
        }

        public override int GetHashCode()
        {
            return 0;
        }
    }

    public class Text
    {
        public static implicit operator Text(string s)
        {
            return new Text();
        }
    }

    public class Animal
    {
        public Animal Parent;
    }

    public class Dog : Animal
    {
    }

    public class C
    {
        public object Run(
            UnityEngine.Component u,
            UnityEngine.Component v,
            Money m,
            dynamic d,
            string s,
            Text t,
            Dog dog,
            Animal animal,
            int? a,
            int? b,
            long? wide)
        {
            var near = u ?? v;
            var tag = u?.tag ?? "untagged";
            var grand = animal?.Parent?.Parent ?? animal;
            var money = m ?? new Money();
            var any = d ?? 1;
            var text = s ?? t;
            int first = a ?? b ?? 0;
            Animal pet = dog ?? animal;
            long? either = a ?? wide;
            return (near, tag, grand, money, any, text, first, pet, either);
        }
    }
}
=== output
namespace UnityEngine
{
    public class Object
    {
    }

    public class Component : Object
    {
        public string tag;
    }
}

namespace N
{
    public class Money
    {
        public static bool operator ==(Money a, Money b)
        {
            return ReferenceEquals(a, b);
        }

        public static bool operator !=(Money a, Money b)
        {
            return !ReferenceEquals(a, b);
        }

        public override bool Equals(object o)
        {
            return ReferenceEquals(this, o);
        }

        public override int GetHashCode()
        {
            return 0;
        }
    }

    public class Text
    {
        public static implicit operator Text(string s)
        {
            return new Text();
        }
    }

    public class Animal
    {
        public Animal Parent;
    }

    public class Dog : Animal
    {
    }

    public class C
    {
        public object Run(
            UnityEngine.Component u,
            UnityEngine.Component v,
            Money m,
            dynamic d,
            string s,
            Text t,
            Dog dog,
            Animal animal,
            int? a,
            int? b,
            long? wide)
        {
            var near = u ?? v;
            string tag = u?.tag;
            if (tag == null)
            {
                tag = "untagged";
            }
            Animal grand = animal?.Parent?.Parent;
            if (grand == null)
            {
                grand = animal;
            }
            var money = m ?? new Money();
            var any = d ?? 1;
            var text = s ?? t;
            int first = a ?? b ?? 0;
            Animal pet = dog;
            if (pet == null)
            {
                pet = animal;
            }
            long? either = a;
            if (!either.HasValue)
            {
                either = wide;
            }
            return (near, tag, grand, money, any, text, first, pet, either);
        }
    }
}
=== queue
73: the type Money has an == of its own, which the rewrite's null check would call
74: dynamic, whose == and conversions are bound when the code runs
75: the left side converts to the type of the ?? by more than a reference conversion: s
76: a chain whose tested values can't share one temporary as they are: a Nullable to unwrap, or a conversion that runs code
76: a chain whose tested values can't share one temporary as they are: a Nullable to unwrap, or a conversion that runs code
