An if condition, a foreach source, a string + and the receiver of a call
take a temporary in front of their statement, and so does a statement in a
lambda's block. A ?: on the right stays inside the if that tests the left
side. Code that may run only sometimes or not at all (the right side of
&&, a branch of ?:, an expression body, a lambda's expression body, an
initializer), a ?? inside another, a variable declared inside, a comment
inside the ?? and a loop condition go to the queue.
=== input
using System;
using System.Collections.Generic;

namespace N
{
    public class Box
    {
        public string Label;
    }

    public class C
    {
        string _name;

        public string Name => _name ?? "none";

        public int Run(bool c, string a, string b, List<int> list, object o)
        {
            int total = 0;
            if ((a ?? "").Length > 2)
            {
                total++;
            }
            foreach (var item in list ?? new List<int>())
            {
                total += item;
            }
            var line = "name: " + (a ?? "none");
            var upper = (a ?? b).ToUpper();
            var pick = a ?? (c ? b : "c");
            Action act = () =>
            {
                Console.WriteLine(a ?? "nothing");
            };
            var both = c && (a ?? "").Length > 0;
            var branch = c ? a ?? b : b;
            Func<string> later = () => a ?? b;
            var box = new Box { Label = a ?? "label" };
            var inner = a ?? (b ?? "x").Trim();
            var cast = (o as string ?? (o is int n ? n.ToString() : "")).Length;
            var noted = a ?? /* fallback */ b;
            while ((a ?? b) != null)
            {
                a = null;
                b = null;
            }
            return total + line.Length + upper.Length + pick.Length
                + both.GetHashCode() + branch.Length + later().Length
                + box.Label.Length + inner.Length + cast + noted.Length;
        }
    }
}
=== output
using System;
using System.Collections.Generic;

namespace N
{
    public class Box
    {
        public string Label;
    }

    public class C
    {
        string _name;

        public string Name => _name ?? "none";

        public int Run(bool c, string a, string b, List<int> list, object o)
        {
            int total = 0;
            string a2 = a;
            if (a2 == null)
            {
                a2 = "";
            }
            if (a2.Length > 2)
            {
                total++;
            }
            List<int> list2 = list;
            if (list2 == null)
            {
                list2 = new List<int>();
            }
            foreach (var item in list2)
            {
                total += item;
            }
            string a3 = a;
            if (a3 == null)
            {
                a3 = "none";
            }
            var line = "name: " + a3;
            string a4 = a;
            if (a4 == null)
            {
                a4 = b;
            }
            var upper = a4.ToUpper();
            string pick = a;
            if (pick == null)
            {
                pick = c ? b : "c";
            }
            Action act = () =>
            {
                string a5 = a;
                if (a5 == null)
                {
                    a5 = "nothing";
                }
                Console.WriteLine(a5);
            };
            var both = c && (a ?? "").Length > 0;
            var branch = c ? a ?? b : b;
            Func<string> later = () => a ?? b;
            var box = new Box { Label = a ?? "label" };
            var inner = a ?? (b ?? "x").Trim();
            var cast = (o as string ?? (o is int n ? n.ToString() : "")).Length;
            var noted = a ?? /* fallback */ b;
            while ((a ?? b) != null)
            {
                a = null;
                b = null;
            }
            return total + line.Length + upper.Length + pick.Length
                + both.GetHashCode() + branch.Length + later().Length
                + box.Label.Length + inner.Length + cast + noted.Length;
        }
    }
}
=== queue
15: an expression body: make it a block first
35: conditionally evaluated: the right side of &&, || or ??
36: conditionally evaluated: a branch of ?:
37: conditionally evaluated: a lambda body
38: an object or collection initializer: the constructor and the earlier elements run first
39: a ?? or ??= inside another one: the inner one would run only sometimes after the rewrite
39: a ?? or ??= inside another one: the inner one would run only sometimes after the rewrite
40: the ?? declares a variable, whose scope the rewrite would change
41: a comment inside the statement would be lost
42: conditionally evaluated: a loop condition
