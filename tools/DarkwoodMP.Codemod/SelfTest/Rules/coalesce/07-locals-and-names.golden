A local or a parameter that a ?? chain is assigned to is filled directly
when nothing can see it in between: no lambda captures it, it is no ref, no
later value reads it, and in a try only literals and locals follow the
first store. "x = f(x ?? b)" fills x in front of its statement, and
"x ?? (x = v)" is "x ??= v". Temporaries are named in the order they are
declared, after what they hold: a call without its get, an element after
what it is. A name that another variable has is passed over rather than
numbered. A ?? in the first value of another, or holding one there, has a
reason of its own.
=== input
using System;
using System.Collections.Generic;
using System.Linq;

namespace N
{
    public class Slot
    {
        public int Id;
        public bool Free;
        public string Label;
    }

    public class Bag
    {
        public T Value<T>(string key)
        {
            return default(T);
        }
    }

    public class C
    {
        List<Slot> _slots = new List<Slot>();

        static string Load(string key)
        {
            return key;
        }

        static List<int> getObjects(int g)
        {
            return null;
        }

        static bool? Parse(string text)
        {
            return null;
        }

        static Bag Json(string text)
        {
            return new Bag();
        }

        static string Clean(string text)
        {
            return text;
        }

        void Targets(string a, string b, ref string r)
        {
            string text = "";
            text = Load(a) ?? Load(b) ?? "-";
            string again = "";
            again = Load(again) ?? "x";
            string later = "";
            later = Load(a) ?? later;
            string seen = "";
            Func<string> read = () => seen;
            seen = Load(a) ?? b;
            r = Load(a) ?? b;
            int count = 0;
            count = getObjects(1)?.Count ?? 0;
            Console.WriteLine(text + again + later + seen + read() + count);
        }

        bool Guarded(string value)
        {
            bool dead;
            string name = "";
            try
            {
                dead = Json(value).Value<bool?>("dead") ?? false;
                name = Load(value) ?? Load("none");
            }
            catch
            {
                return true;
            }
            return dead && name.Length > 0;
        }

        string Refill(string name, string fallback)
        {
            name = (name ?? "").Trim();
            fallback = Clean(fallback ?? name);
            name = string.Concat(name ?? "", name);
            return name + fallback;
        }

        int Fills(int d)
        {
            List<int> gone = null;
            (gone ?? (gone = new List<int>())).Add(d);
            return gone.Count;
        }

        string Names(List<Slot> found, string name)
        {
            int count = Math.Max(5, getObjects(2)?.Count ?? 0);
            int firstId = _slots.FirstOrDefault(s => !s.Free)?.Id ?? 0;
            if (!(Parse(name) ?? false))
            {
                return "" + count + firstId;
            }
            var labels = found.Select(s => s.Label ?? "").ToList()
                ?? new List<string>();
            string pair = Load(name) ?? Clean(Load("b") ?? "x");
            Console.WriteLine(labels.Count + pair);
            return found.Select(s => s.Label).FirstOrDefault() ?? "none";
        }
    }
}
=== output
using System;
using System.Collections.Generic;
using System.Linq;

namespace N
{
    public class Slot
    {
        public int Id;
        public bool Free;
        public string Label;
    }

    public class Bag
    {
        public T Value<T>(string key)
        {
            return default(T);
        }
    }

    public class C
    {
        List<Slot> _slots = new List<Slot>();

        static string Load(string key)
        {
            return key;
        }

        static List<int> getObjects(int g)
        {
            return null;
        }

        static bool? Parse(string text)
        {
            return null;
        }

        static Bag Json(string text)
        {
            return new Bag();
        }

        static string Clean(string text)
        {
            return text;
        }

        void Targets(string a, string b, ref string r)
        {
            string text = "";
            text = Load(a);
            if (text == null)
            {
                text = Load(b);
            }
            if (text == null)
            {
                text = "-";
            }
            string again = "";
            again = Load(again);
            if (again == null)
            {
                again = "x";
            }
            string later = "";
            string later2 = Load(a);
            if (later2 == null)
            {
                later2 = later;
            }
            later = later2;
            string seen = "";
            Func<string> read = () => seen;
            string seen2 = Load(a);
            if (seen2 == null)
            {
                seen2 = b;
            }
            seen = seen2;
            string r2 = Load(a);
            if (r2 == null)
            {
                r2 = b;
            }
            r = r2;
            int count = 0;
            List<int> objects = getObjects(1);
            count = 0;
            if (objects != null)
            {
                count = objects.Count;
            }
            Console.WriteLine(text + again + later + seen + read() + count);
        }

        bool Guarded(string value)
        {
            bool dead;
            string name = "";
            try
            {
                bool? dead2 = Json(value).Value<bool?>("dead");
                dead = false;
                if (dead2.HasValue)
                {
                    dead = dead2.Value;
                }
                string name2 = Load(value);
                if (name2 == null)
                {
                    name2 = Load("none");
                }
                name = name2;
            }
            catch
            {
                return true;
            }
            return dead && name.Length > 0;
        }

        string Refill(string name, string fallback)
        {
            if (name == null)
            {
                name = "";
            }
            name = name.Trim();
            if (fallback == null)
            {
                fallback = name;
            }
            fallback = Clean(fallback);
            string name2 = name;
            if (name2 == null)
            {
                name2 = "";
            }
            name = string.Concat(name2, name);
            return name + fallback;
        }

        int Fills(int d)
        {
            List<int> gone = null;
            if (gone == null)
            {
                gone = new List<int>();
            }
            gone.Add(d);
            return gone.Count;
        }

        string Names(List<Slot> found, string name)
        {
            List<int> objects = getObjects(2);
            int count2 = 0;
            if (objects != null)
            {
                count2 = objects.Count;
            }
            int count = Math.Max(5, count2);
            Slot slot = _slots.FirstOrDefault(s => !s.Free);
            int firstId = 0;
            if (slot != null)
            {
                firstId = slot.Id;
            }
            bool? parse = Parse(name);
            bool parse2 = false;
            if (parse.HasValue)
            {
                parse2 = parse.Value;
            }
            if (!parse2)
            {
                return "" + count + firstId;
            }
            var labels = found.Select(s => s.Label ?? "").ToList()
                ?? new List<string>();
            string pair = Load(name) ?? Clean(Load("b") ?? "x");
            Console.WriteLine(labels.Count + pair);
            string label = found.Select(s => s.Label).FirstOrDefault();
            if (label == null)
            {
                label = "none";
            }
            return label;
        }
    }
}
=== queue
107: inside the first value of another ?? or ??=, which runs every time: rewrite one level per run
107: holds another ?? or ??= in its first value, which runs every time: rewrite one level per run
109: a ?? or ??= inside another one: the inner one would run only sometimes after the rewrite
109: a ?? or ??= inside another one: the inner one would run only sometimes after the rewrite
