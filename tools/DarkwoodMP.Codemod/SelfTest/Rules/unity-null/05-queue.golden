namespace N
{
    using UnityEngine;

    public class Special : GameObject
    {
        public static bool operator ==(Special a, Special b)
        {
            return ReferenceEquals(a, b);
        }

        public static bool operator !=(Special a, Special b)
        {
            return !ReferenceEquals(a, b);
        }

        public override bool Equals(object o)
        {
            return ReferenceEquals(this, o);
        }

        public override int GetHashCode()
        {
            return 1;
        }
    }

    public class Part : GameObject
    {
        public void Take(GameObject other)
        {
        }
    }

    public interface IHit
    {
        void Hit();
    }

    public class C
    {
        public GameObject Make()
        {
            return new GameObject();
        }

        public bool Use(string text)
        {
            return text != null;
        }

        public void Two(GameObject a, GameObject b)
        {
        }

        public object Queue(
            GameObject a, GameObject b, Special s, Special s2, Part part,
            Holder h, IHit i, object any, int k)
        {
            s?.Hit();
            Special t = s ?? s2;
            object o = a ?? (object)"x";
            i?.Hit();
            var text = any?.ToString();
            Two(Make(), a?.parent);
            GameObject x = a ?? (b as GameObject)?.parent;
            GameObject y = a;
            if (y == null)
            {
                y = (any as Holder)?.root;
            }
            Two(Make(), a?.parent ?? b);
            part?.Take(a ?? b);
            h?.Use(a?.name);
            bool ok = k > 0 && Use(a?.name);
            string u = k > 0 ? a?.name : "";
            return (t, o, text, x, y, ok, u);
        }

        public string Name<T>(T value) where T : GameObject
        {
            return value?.name;
        }
    }
}
=== queue
126: the Unity class Special declares an == of its own, which the rewrite's null check would call
127: the Unity class Special declares an == of its own, which the rewrite's null check would call
128: a Unity object tested by a ?? of the type Object, whose null check would be by reference
131: a call runs earlier in the statement: Make()
132: inside a ?? or ??= that tests a Unity object: rewrite one level per run
132: holds a ?. that tests a Unity object, and doesn't open it: rewrite one level per run
134: inside a ?? or ??= that tests a Unity object: rewrite one level per run
134: a call runs earlier in the statement: Make()
135: inside a ?. that tests a Unity object: rewrite one level per run
135: holds a ?? or ??= that tests a Unity object: rewrite one level per run
136: inside the part after another ?., which runs only when its receiver isn't null: rewrite one level per run
137: conditionally evaluated: the right side of &&, || or ??
138: conditionally evaluated: a branch of ?:
144: a Unity object of a type parameter, whose null check the rewrite doesn't write
