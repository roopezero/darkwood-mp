The traps of the pattern tables hold under Unity's check: "go?.count !=
5" is true for a null go, a boxed value keeps its natural type, a target
with a call in it or a mutable value read in front of a ?. with effects
sends the site to the queue, and so do a field initializer, a for
iterator and an await in the statement. A comparison keeps its place in
an else-if and a loop condition, where no statement can go.
=== input
using System;

namespace UnityEngine
{
    public class Object
    {
        public string name;

        public static bool operator ==(Object a, Object b)
        {
            return ReferenceEquals(a, b);
        }

        public static bool operator !=(Object a, Object b)
        {
            return !ReferenceEquals(a, b);
        }

        public static implicit operator bool(Object a)
        {
            return !ReferenceEquals(a, null);
        }

        public override bool Equals(object o)
        {
            return ReferenceEquals(this, o);
        }

        public override int GetHashCode()
        {
            return 0;
        }
    }

    public class GameObject : Object
    {
        public int count;
        public bool active;
        public GameObject parent;
        public Holder holder;
        public Action<int> onHit;

        public void Hit()
        {
        }

        public int this[string key]
        {
            get
            {
                return key.Length;
            }
        }
    }

    public class Holder
    {
        public GameObject root;
        public string tag;

        public void Use(string text)
        {
        }
    }
}

namespace N
{
    using System.Threading.Tasks;
    using UnityEngine;

    public class Part : GameObject
    {
        public int Bump()
        {
            count++;
            return count;
        }
    }

    public class Holders
    {
        public static GameObject Main { get; set; }
    }

    public class C
    {
        static string _first = Holders.Main?.name;
        int _count;
        string[] _names = new string[2];

        public int Index()
        {
            return 1;
        }

        public void Log(string text)
        {
        }

        public void Pair(int a, int? b)
        {
        }

        public object Traps(GameObject go, Part part, int? total)
        {
            bool p = go?.count != 5;
            object n = go?.count;
            _names[Index()] = go?.name;
            total += go?.count;
            Pair(_count, part?.Bump());
            if (go == null)
            {
                Log("none");
            }
            else if (go?.name == "x")
            {
                Log("x");
            }
            while (go?.parent != null && go.parent.active)
            {
                go = go.parent;
            }
            for (int i = 0; i < 2; Log(go?.name))
            {
                i++;
            }
            return (p, n, total, _first);
        }

        public async Task Wait(GameObject go)
        {
            Log(go?.name + await Task.FromResult(""));
        }
    }
}
=== output
using System;

namespace UnityEngine
{
    public class Object
    {
        public string name;

        public static bool operator ==(Object a, Object b)
        {
            return ReferenceEquals(a, b);
        }

        public static bool operator !=(Object a, Object b)
        {
            return !ReferenceEquals(a, b);
        }

        public static implicit operator bool(Object a)
        {
            return !ReferenceEquals(a, null);
        }

        public override bool Equals(object o)
        {
            return ReferenceEquals(this, o);
        }

        public override int GetHashCode()
        {
            return 0;
        }
    }

    public class GameObject : Object
    {
        public int count;
        public bool active;
        public GameObject parent;
        public Holder holder;
        public Action<int> onHit;

        public void Hit()
        {
        }

        public int this[string key]
        {
            get
            {
                return key.Length;
            }
        }
    }

    public class Holder
    {
        public GameObject root;
        public string tag;

        public void Use(string text)
        {
        }
    }
}

namespace N
{
    using System.Threading.Tasks;
    using UnityEngine;

    public class Part : GameObject
    {
        public int Bump()
        {
            count++;
            return count;
        }
    }

    public class Holders
    {
        public static GameObject Main { get; set; }
    }

    public class C
    {
        static string _first = Holders.Main?.name;
        int _count;
        string[] _names = new string[2];

        public int Index()
        {
            return 1;
        }

        public void Log(string text)
        {
        }

        public void Pair(int a, int? b)
        {
        }

        public object Traps(GameObject go, Part part, int? total)
        {
            bool p = go == null || go.count != 5;
            int? count = null;
            if (go != null)
            {
                count = go.count;
            }
            object n = count;
            _names[Index()] = go?.name;
            int? total2 = null;
            if (go != null)
            {
                total2 = go.count;
            }
            total += total2;
            Pair(_count, part?.Bump());
            if (go == null)
            {
                Log("none");
            }
            else if (go != null && go.name == "x")
            {
                Log("x");
            }
            while (go != null && go.parent != null && go.parent.active)
            {
                go = go.parent;
            }
            for (int i = 0; i < 2; Log(go?.name))
            {
                i++;
            }
            return (p, n, total, _first);
        }

        public async Task Wait(GameObject go)
        {
            Log(go?.name + await Task.FromResult(""));
        }
    }
}
=== queue
88: not a local declaration: FieldDeclaration
109: a call runs earlier in the statement: Index()
111: the hoisted code has effects and a mutable value is read earlier: _count
124: conditionally evaluated: a for header
133: an await in the statement: a temporary could become a field of the state machine
