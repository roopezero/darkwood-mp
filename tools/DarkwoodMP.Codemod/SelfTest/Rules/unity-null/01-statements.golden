A statement on a ?. that tests a Unity object becomes an if whose check
is Unity's "x != null": a local receiver is tested as it is, one that
isn't a local, a parameter or this goes into a temporary first, and a
destroyed this is skipped too. A chain gets an if per ?., with Unity's
check on a Unity value and the reference check on any other, as when a
receiver that isn't a Unity object has a Unity member. A delegate after
a Unity receiver is called through its temporary, and ?[ is a step like
any other. A chain that tests no Unity object is stage 6's, and stays.
=== input
using System;

namespace UnityEngine
{
    public class Object
    {
        public string name;

        public static bool operator ==(Object a, Object b)
        {
            return ReferenceEquals(a, b);
        }

        public static bool operator !=(Object a, Object b)
        {
            return !ReferenceEquals(a, b);
        }

        public static implicit operator bool(Object a)
        {
            return !ReferenceEquals(a, null);
        }

        public override bool Equals(object o)
        {
            return ReferenceEquals(this, o);
        }

        public override int GetHashCode()
        {
            return 0;
        }
    }

    public class GameObject : Object
    {
        public int count;
        public bool active;
        public GameObject parent;
        public Holder holder;
        public Action<int> onHit;

        public void Hit()
        {
        }

        public int this[string key]
        {
            get
            {
                return key.Length;
            }
        }
    }

    public class Holder
    {
        public GameObject root;
        public string tag;

        public void Use(string text)
        {
        }
    }
}

namespace N
{
    using UnityEngine;

    public class Holders
    {
        public static GameObject Main { get; set; }
    }

    public class C : GameObject
    {
        GameObject _go;

        public void Run(GameObject go, Holder h, Holder plain)
        {
            go?.Hit();
            Holders.Main?.Hit();
            _go?.Hit();
            this?.Hit();
            go?.holder?.root?.Hit();
            h?.root?.Hit();
            go?.onHit?.Invoke(3);
            plain?.Use("x");
        }

        public int Key(GameObject go)
        {
            int? n = go?["walk"];
            return n.GetValueOrDefault();
        }
    }
}
=== output
using System;

namespace UnityEngine
{
    public class Object
    {
        public string name;

        public static bool operator ==(Object a, Object b)
        {
            return ReferenceEquals(a, b);
        }

        public static bool operator !=(Object a, Object b)
        {
            return !ReferenceEquals(a, b);
        }

        public static implicit operator bool(Object a)
        {
            return !ReferenceEquals(a, null);
        }

        public override bool Equals(object o)
        {
            return ReferenceEquals(this, o);
        }

        public override int GetHashCode()
        {
            return 0;
        }
    }

    public class GameObject : Object
    {
        public int count;
        public bool active;
        public GameObject parent;
        public Holder holder;
        public Action<int> onHit;

        public void Hit()
        {
        }

        public int this[string key]
        {
            get
            {
                return key.Length;
            }
        }
    }

    public class Holder
    {
        public GameObject root;
        public string tag;

        public void Use(string text)
        {
        }
    }
}

namespace N
{
    using UnityEngine;

    public class Holders
    {
        public static GameObject Main { get; set; }
    }

    public class C : GameObject
    {
        GameObject _go;

        public void Run(GameObject go, Holder h, Holder plain)
        {
            if (go != null)
            {
                go.Hit();
            }
            GameObject main = Holders.Main;
            if (main != null)
            {
                main.Hit();
            }
            GameObject go2 = _go;
            if (go2 != null)
            {
                go2.Hit();
            }
            if (this != null)
            {
                this.Hit();
            }
            if (go != null)
            {
                Holder holder = go.holder;
                if (holder != null)
                {
                    GameObject root = holder.root;
                    if (root != null)
                    {
                        root.Hit();
                    }
                }
            }
            if (h != null)
            {
                GameObject root2 = h.root;
                if (root2 != null)
                {
                    root2.Hit();
                }
            }
            if (go != null)
            {
                Action<int> onHit = go.onHit;
                if (onHit != null)
                {
                    onHit(3);
                }
            }
            plain?.Use("x");
        }

        public int Key(GameObject go)
        {
            int? n = null;
            if (go != null)
            {
                n = go["walk"];
            }
            return n.GetValueOrDefault();
        }
    }
}
