A ?? or ??= that tests a Unity object becomes the ifs of stage 5 with
Unity's "x == null", so a destroyed value is replaced too: a declaration
of the type of the ??, a chain, an assignment to a field through a
temporary, a return, an argument, a local that is the temporary, a ??=
statement, and a ??= used as a value. A first value "r?.m" is opened
with its ??, Unity's check on a Unity receiver and the reference check on
any other, and a receiver that is a call is read once, into a temporary,
in a declaration, an assignment to a field and a return. A value of a
derived Unity type fills a temporary of the base type, and one stored to
object is tested before the conversion.
=== input
using System;

namespace UnityEngine
{
    public class Object
    {
        public string name;

        public static bool operator ==(Object a, Object b)
        {
            return ReferenceEquals(a, b);
        }

        public static bool operator !=(Object a, Object b)
        {
            return !ReferenceEquals(a, b);
        }

        public static implicit operator bool(Object a)
        {
            return !ReferenceEquals(a, null);
        }

        public override bool Equals(object o)
        {
            return ReferenceEquals(this, o);
        }

        public override int GetHashCode()
        {
            return 0;
        }
    }

    public class GameObject : Object
    {
        public int count;
        public bool active;
        public GameObject parent;
        public Holder holder;
        public Action<int> onHit;

        public void Hit()
        {
        }

        public GameObject Find(string name)
        {
            return parent;
        }

        public int this[string key]
        {
            get
            {
                return key.Length;
            }
        }
    }

    public class Holder
    {
        public GameObject root;
        public string tag;

        public void Use(string text)
        {
        }
    }
}

namespace N
{
    using UnityEngine;

    public class Part : GameObject
    {
    }

    public class C
    {
        GameObject _go;
        GameObject _cache;

        public GameObject Make()
        {
            return new GameObject();
        }

        public void Use(GameObject go)
        {
        }

        public object Values(GameObject a, GameObject b, GameObject c, Holder h)
        {
            GameObject d = a ?? b;
            var e = a ?? b ?? c;
            _go = a ?? Make();
            var f = h?.root ?? a;
            var g = a?.parent ?? b;
            GameObject p = (Part)a ?? b;
            object o = a ?? b;
            Use(a ?? b);
            c = a ?? c;
            return (d, e, f, g, p, o);
        }

        public GameObject Back(GameObject a, GameObject b)
        {
            return a ?? b;
        }

        public void Fill()
        {
            _cache ??= Make();
            (_go ??= Make()).Hit();
        }

        public GameObject Tip(GameObject screen, GameObject b)
        {
            var tip = screen.Find("Tip")?.parent ?? b;
            return tip;
        }

        public void Store(GameObject b)
        {
            _go = Make()?.parent ?? b;
        }

        public GameObject Found(GameObject screen, GameObject b)
        {
            return screen.Find("Back")?.parent ?? b;
        }
    }
}
=== output
using System;

namespace UnityEngine
{
    public class Object
    {
        public string name;

        public static bool operator ==(Object a, Object b)
        {
            return ReferenceEquals(a, b);
        }

        public static bool operator !=(Object a, Object b)
        {
            return !ReferenceEquals(a, b);
        }

        public static implicit operator bool(Object a)
        {
            return !ReferenceEquals(a, null);
        }

        public override bool Equals(object o)
        {
            return ReferenceEquals(this, o);
        }

        public override int GetHashCode()
        {
            return 0;
        }
    }

    public class GameObject : Object
    {
        public int count;
        public bool active;
        public GameObject parent;
        public Holder holder;
        public Action<int> onHit;

        public void Hit()
        {
        }

        public GameObject Find(string name)
        {
            return parent;
        }

        public int this[string key]
        {
            get
            {
                return key.Length;
            }
        }
    }

    public class Holder
    {
        public GameObject root;
        public string tag;

        public void Use(string text)
        {
        }
    }
}

namespace N
{
    using UnityEngine;

    public class Part : GameObject
    {
    }

    public class C
    {
        GameObject _go;
        GameObject _cache;

        public GameObject Make()
        {
            return new GameObject();
        }

        public void Use(GameObject go)
        {
        }

        public object Values(GameObject a, GameObject b, GameObject c, Holder h)
        {
            GameObject d = a;
            if (d == null)
            {
                d = b;
            }
            GameObject e = a;
            if (e == null)
            {
                e = b;
            }
            if (e == null)
            {
                e = c;
            }
            GameObject go = a;
            if (go == null)
            {
                go = Make();
            }
            _go = go;
            GameObject f = null;
            if (h != null)
            {
                f = h.root;
            }
            if (f == null)
            {
                f = a;
            }
            GameObject g = null;
            if (a != null)
            {
                g = a.parent;
            }
            if (g == null)
            {
                g = b;
            }
            GameObject p = (Part)a;
            if (p == null)
            {
                p = b;
            }
            GameObject a2 = a;
            if (a2 == null)
            {
                a2 = b;
            }
            object o = a2;
            GameObject go2 = a;
            if (go2 == null)
            {
                go2 = b;
            }
            Use(go2);
            GameObject c2 = a;
            if (c2 == null)
            {
                c2 = c;
            }
            c = c2;
            return (d, e, f, g, p, o);
        }

        public GameObject Back(GameObject a, GameObject b)
        {
            GameObject a2 = a;
            if (a2 == null)
            {
                a2 = b;
            }
            return a2;
        }

        public void Fill()
        {
            if (_cache == null)
            {
                _cache = Make();
            }
            GameObject go = _go;
            if (go == null)
            {
                go = Make();
                _go = go;
            }
            go.Hit();
        }

        public GameObject Tip(GameObject screen, GameObject b)
        {
            GameObject gameObject = screen.Find("Tip");
            GameObject tip = null;
            if (gameObject != null)
            {
                tip = gameObject.parent;
            }
            if (tip == null)
            {
                tip = b;
            }
            return tip;
        }

        public void Store(GameObject b)
        {
            GameObject gameObject = Make();
            GameObject go = null;
            if (gameObject != null)
            {
                go = gameObject.parent;
            }
            if (go == null)
            {
                go = b;
            }
            _go = go;
        }

        public GameObject Found(GameObject screen, GameObject b)
        {
            GameObject gameObject = screen.Find("Back");
            GameObject parent = null;
            if (gameObject != null)
            {
                parent = gameObject.parent;
            }
            if (parent == null)
            {
                parent = b;
            }
            return parent;
        }
    }
}
