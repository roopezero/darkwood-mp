Arguments and operands. The ?: moves into a temporary of its natural type
in front of its statement, named after the parameter it is passed to or
after what its branches have in common: an object argument still boxes the
double the ?: made (hazard 1). A literal last value starts the temporary,
a nested ?: becomes an else-if, a throw branch a throw statement. Several
in one statement move in the order they run, and what runs after them
stays after them. A ?: inside a nested assignment, an index, a tuple, the
receiver of a call and the right side of a string + moves the same way.
=== input
using System;
using System.Collections.Generic;

namespace N
{
    public struct Counter
    {
        public int N;

        public int Next()
        {
            N++;
            return N;
        }
    }

    public class C
    {
        static void Take(object box, int count)
        {
        }

        static int Twice(int value)
        {
            return value * 2;
        }

        static int Sum(int left, int right)
        {
            return left + right;
        }

        public string Run(bool c, bool d, int i, int[] cells, Counter a, Counter b)
        {
            Take(c ? 1 : 2.5, i);
            Take(i, c ? i : -1);
            int n = Twice(c ? i : d ? 2 : 3);
            n += Twice(c ? i : throw new ArgumentException("no"));
            n = Sum(c ? 1 : 2, d ? 3 : 4) + Twice(n);
            Twice(n = c ? i : 0);
            cells[c ? 0 : 1] = n;
            var pair = (c ? i : 0, n);
            int next = (c ? a : b).Next();
            string text = "n=" + n + (d ? "!" : "?");
            n -= Twice(d ? n : 1);
            return text + pair + next;
        }
    }
}
=== output
using System;
using System.Collections.Generic;

namespace N
{
    public struct Counter
    {
        public int N;

        public int Next()
        {
            N++;
            return N;
        }
    }

    public class C
    {
        static void Take(object box, int count)
        {
        }

        static int Twice(int value)
        {
            return value * 2;
        }

        static int Sum(int left, int right)
        {
            return left + right;
        }

        public string Run(bool c, bool d, int i, int[] cells, Counter a, Counter b)
        {
            double box = 2.5;
            if (c)
            {
                box = 1;
            }
            Take(box, i);
            int count = -1;
            if (c)
            {
                count = i;
            }
            Take(i, count);
            int value = 3;
            if (c)
            {
                value = i;
            }
            else if (d)
            {
                value = 2;
            }
            int n = Twice(value);
            int value2;
            if (c)
            {
                value2 = i;
            }
            else
            {
                throw new ArgumentException("no");
            }
            n += Twice(value2);
            int left = 2;
            if (c)
            {
                left = 1;
            }
            int right = 4;
            if (d)
            {
                right = 3;
            }
            n = Sum(left, right) + Twice(n);
            int value3 = 0;
            if (c)
            {
                value3 = i;
            }
            Twice(n = value3);
            int value4 = 1;
            if (c)
            {
                value4 = 0;
            }
            cells[value4] = n;
            int value5 = 0;
            if (c)
            {
                value5 = i;
            }
            var pair = (value5, n);
            Counter value6;
            if (c)
            {
                value6 = a;
            }
            else
            {
                value6 = b;
            }
            int next = value6.Next();
            string value7 = "?";
            if (d)
            {
                value7 = "!";
            }
            string text = "n=" + n + value7;
            int value8 = 1;
            if (d)
            {
                value8 = n;
            }
            n -= Twice(value8);
            return text + pair + next;
        }
    }
}
