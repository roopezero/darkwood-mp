?: inside one that moves. A ?: in a branch moves in front of that
branch's statement (its store, or the throw a throw branch becomes), one
in the first condition in front of the whole if, and the hazards are those
of the new statement: only what runs before it in its branch or
condition. One in an else-if condition has no statement of its own to go
in front of. A block lambda in a branch keeps its own statements, whose ?:
move inside it, and so does a lambda's block anywhere else.
=== input
using System;

namespace N
{
    public class C
    {
        int _n;

        static int Twice(int value)
        {
            return value * 2;
        }

        int Bump()
        {
            return ++_n;
        }

        static int Sum(int a, int b)
        {
            return a + b;
        }

        public int Run(bool c, bool d, bool e, int i, Func<int> f)
        {
            int a = Twice(c ? Twice(d ? i : 1) : 0);
            int b = Twice(c ? Sum(_n, d ? Bump() : 0) : 0);
            int g = Twice(Twice(d ? 1 : 2) > 1 ? i : 0);
            int h = Twice(c ? 1 : Twice(d ? 2 : 3) > 4 ? 5 : 6);
            int k = Twice(c ? i : throw new ArgumentException(d ? "a" : "b"));
            Func<int> l = Twice(i) > 0 ? f : () =>
            {
                return Twice(e ? 1 : 2);
            };
            int m = Twice(c ? Run(() =>
            {
                return Twice(e ? 3 : 4);
            }) : 0);
            return a + b + g + h + k + l() + m;
        }

        static int Run(Func<int> f)
        {
            return f();
        }
    }
}
=== output
using System;

namespace N
{
    public class C
    {
        int _n;

        static int Twice(int value)
        {
            return value * 2;
        }

        int Bump()
        {
            return ++_n;
        }

        static int Sum(int a, int b)
        {
            return a + b;
        }

        public int Run(bool c, bool d, bool e, int i, Func<int> f)
        {
            int twice = 0;
            if (c)
            {
                int value = 1;
                if (d)
                {
                    value = i;
                }
                twice = Twice(value);
            }
            int a = Twice(twice);
            int sum = 0;
            if (c)
            {
                sum = Sum(_n, d ? Bump() : 0);
            }
            int b = Twice(sum);
            int value3 = 2;
            if (d)
            {
                value3 = 1;
            }
            int value2 = 0;
            if (Twice(value3) > 1)
            {
                value2 = i;
            }
            int g = Twice(value2);
            int value4 = 6;
            if (c)
            {
                value4 = 1;
            }
            else if (Twice(d ? 2 : 3) > 4)
            {
                value4 = 5;
            }
            int h = Twice(value4);
            int value5;
            if (c)
            {
                value5 = i;
            }
            else
            {
                string message = "b";
                if (d)
                {
                    message = "a";
                }
                throw new ArgumentException(message);
            }
            int k = Twice(value5);
            Func<int> l = Twice(i) > 0 ? f : () =>
            {
                int value6 = 2;
                if (e)
                {
                    value6 = 1;
                }
                return Twice(value6);
            };
            int run = 0;
            if (c)
            {
                run = Run(() =>
                {
                    int value7 = 4;
                    if (e)
                    {
                        value7 = 3;
                    }
                    return Twice(value7);
                });
            }
            int m = Twice(run);
            return a + b + g + h + k + l() + m;
        }

        static int Run(Func<int> f)
        {
            return f();
        }
    }
}
=== queue
27: the hoisted code has effects and a mutable value is read earlier: _n
29: conditionally evaluated: an else-if condition of a ?: that moves
