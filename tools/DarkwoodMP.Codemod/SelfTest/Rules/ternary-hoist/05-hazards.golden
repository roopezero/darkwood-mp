Hazards (guide section 4.6, codemod.md section 5.3). A ?: without effects
may move in front of what has none; one with effects only in front of
values it can't change: a literal, this, a readonly field, a getter that
only reads one, a local or parameter it doesn't write and no lambda
captures. So a call earlier (hazard 4), a mutable field (hazard 8), a
captured local, a local the ?: writes and a getter with a body keep the ?:
where it is. So do a member read through an object that may be null,
which would throw only after the ?:'s effects; a user-defined conversion
the compiler applies to an earlier argument; a delegate in a field the
call reads first; a volatile read, which keeps later reads behind it; and
a string + whose left side the mod's ToString makes into text. A getter
that only reads a field has no effects.
=== input
using System;

namespace N
{
    public class Box
    {
        public int Size;
        readonly int _fixed = 2;
        int _loose;

        public int Fixed => _fixed;

        public int Loose
        {
            get
            {
                return _loose;
            }
        }

        public int Computed
        {
            get
            {
                return _loose + 1;
            }
        }
    }

    public struct Meters
    {
        public int Value;

        public static implicit operator int(Meters m)
        {
            return m.Value;
        }
    }

    public class Named
    {
        public override string ToString()
        {
            return "named";
        }
    }

    public class C
    {
        int _n;
        volatile int _seen;
        readonly int _limit = 9;
        readonly Box _box = new Box();
        Func<int, int> _handler = x => x;

        public int Limit => _limit;

        int Bump()
        {
            return ++_n;
        }

        static int Sum(int a, int b)
        {
            return a + b;
        }

        public int Run(bool c, int local, int kept, Box other, Meters m, Named named)
        {
            int total = Sum(Bump(), c ? 2 : 3);
            total += Sum(_n, c ? Bump() : 0);
            total += Sum(local, c ? Bump() : 0);
            total += Sum(_limit, c ? Bump() : 0);
            total += Sum(Limit, c ? Bump() : 0);
            total += Sum(_box.Size, c ? 2 : 3);
            total += Sum(other.Fixed, c ? 2 : 3);
            total += Sum(other.Loose, c ? 2 : 3);
            total += Sum(other.Computed, c ? 2 : 3);
            total += Sum(other.Size, c ? Bump() : 0);
            total += Sum(other.Fixed, c ? Bump() : 0);
            total += Sum(m, c ? Bump() : 0);
            total += Sum(local, c ? (local = 5) : 0);
            total += _handler(c ? Bump() : 0);
            total += Sum(_seen, c ? 2 : 3);
            Func<int> read = () => kept;
            total += Sum(kept, c ? Bump() : 0);
            string text = named + (c ? "!" : "?");
            return total + read() + text.Length;
        }
    }
}
=== output
using System;

namespace N
{
    public class Box
    {
        public int Size;
        readonly int _fixed = 2;
        int _loose;

        public int Fixed => _fixed;

        public int Loose
        {
            get
            {
                return _loose;
            }
        }

        public int Computed
        {
            get
            {
                return _loose + 1;
            }
        }
    }

    public struct Meters
    {
        public int Value;

        public static implicit operator int(Meters m)
        {
            return m.Value;
        }
    }

    public class Named
    {
        public override string ToString()
        {
            return "named";
        }
    }

    public class C
    {
        int _n;
        volatile int _seen;
        readonly int _limit = 9;
        readonly Box _box = new Box();
        Func<int, int> _handler = x => x;

        public int Limit => _limit;

        int Bump()
        {
            return ++_n;
        }

        static int Sum(int a, int b)
        {
            return a + b;
        }

        public int Run(bool c, int local, int kept, Box other, Meters m, Named named)
        {
            int total = Sum(Bump(), c ? 2 : 3);
            total += Sum(_n, c ? Bump() : 0);
            int b = 0;
            if (c)
            {
                b = Bump();
            }
            total += Sum(local, b);
            int b2 = 0;
            if (c)
            {
                b2 = Bump();
            }
            total += Sum(_limit, b2);
            int b3 = 0;
            if (c)
            {
                b3 = Bump();
            }
            total += Sum(Limit, b3);
            int b4 = 3;
            if (c)
            {
                b4 = 2;
            }
            total += Sum(_box.Size, b4);
            int b5 = 3;
            if (c)
            {
                b5 = 2;
            }
            total += Sum(other.Fixed, b5);
            int b6 = 3;
            if (c)
            {
                b6 = 2;
            }
            total += Sum(other.Loose, b6);
            total += Sum(other.Computed, c ? 2 : 3);
            total += Sum(other.Size, c ? Bump() : 0);
            total += Sum(other.Fixed, c ? Bump() : 0);
            total += Sum(m, c ? Bump() : 0);
            total += Sum(local, c ? (local = 5) : 0);
            total += _handler(c ? Bump() : 0);
            total += Sum(_seen, c ? 2 : 3);
            Func<int> read = () => kept;
            total += Sum(kept, c ? Bump() : 0);
            string text = named + (c ? "!" : "?");
            return total + read() + text.Length;
        }
    }
}
=== queue
70: a call runs earlier in the statement: Bump()
71: the hoisted code has effects and a mutable value is read earlier: _n
78: a call runs earlier in the statement: other.Computed
79: the hoisted code has effects and a mutable value is read earlier: other.Size
80: the hoisted code has effects and a read earlier can throw: other.Fixed
81: a call runs earlier in the statement: converting m
82: the hoisted code has effects and a mutable value is read earlier: local
83: the hoisted code has effects and a mutable value is read earlier: _handler
84: a volatile field is read earlier: _seen
86: the hoisted code has effects and a mutable value is read earlier: kept
87: an earlier value is made into text by code that isn't plain: named
