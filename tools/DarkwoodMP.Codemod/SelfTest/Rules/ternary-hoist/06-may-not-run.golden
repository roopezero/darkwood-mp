Code that may not run, and contexts the rule doesn't take. Nothing moves
out of the right side of &&, || or ??, the right side of ??=, a branch of
another ?:, the part after ?., a lambda or an expression body, a switch
expression arm or a when clause: moved in front of the statement it would
run every time. An object or collection initializer runs every time, but
after the constructor and the elements before it. checked() would
be left behind, a deconstruction's targets run first, and a statement in
an interpolation hole can take no statement in front of it. A constant
condition, a ?: whose every branch throws and an anonymous type go to the
queue too. A ?: that is the whole value of its context is ternary-direct's
and stays out of this rule's queue.
=== input
using System;
using System.Collections.Generic;

namespace N
{
    public class Item
    {
        public int Size;
        public List<int> Parts = new List<int>();
    }

    public class C
    {
        const bool Always = true;
        List<int> _list;
        int? _maybe;

        static int Twice(int value)
        {
            return value * 2;
        }

        int Total => Twice(_list.Count > 0 ? 1 : 2);

        public int Run(bool c, bool d, int i, Item item, string s, Func<int, int> f)
        {
            bool both = c && Twice(d ? i : 0) > 2;
            bool either = c || Twice(d ? i : 0) > 2;
            string text = s ?? (d ? "a" : "b").Trim();
            _maybe ??= Twice(c ? 1 : 2);
            int x = c ? Twice(d ? 1 : 2) : 0;
            int? size = item?.Parts.IndexOf(c ? 1 : 2);
            Func<int, int> g = y => Twice(c ? y : 0);
            var made = new Item { Size = c ? 1 : 2 };
            var list = new List<int> { d ? 3 : 4 };
            int arm = i switch
            {
                0 => Twice(c ? 1 : 2),
                _ => 0,
            };
            switch (i)
            {
                case 1 when Twice(c ? i : 0) > 0:
                    arm++;
                    break;
            }
            int sum = checked(Twice(c ? i + 1 : i));
            (int first, int second) = (Twice(c ? 1 : 2), 3);
            string holed = $"{Run2(() =>
            {
                return Twice(c ? 1 : 2);
            })}";
            int fixedValue = Twice(Always ? 1 : 2);
            int thrown = Twice(c ? throw new ArgumentException() : throw new InvalidOperationException());
            var anon = Run3(c ? new { A = 1 } : new { A = 2 });
            int whole = c ? i : 0;
            return x + (size ?? 0) + g(i) + made.Size + list.Count + sum + first + second + fixedValue + thrown + anon + whole + holed.Length + Total
                + (_maybe ?? 0);
        }

        static int Run2(Func<int> f)
        {
            return f();
        }

        static int Run3(object o)
        {
            return o.GetHashCode();
        }
    }
}
=== output
using System;
using System.Collections.Generic;

namespace N
{
    public class Item
    {
        public int Size;
        public List<int> Parts = new List<int>();
    }

    public class C
    {
        const bool Always = true;
        List<int> _list;
        int? _maybe;

        static int Twice(int value)
        {
            return value * 2;
        }

        int Total => Twice(_list.Count > 0 ? 1 : 2);

        public int Run(bool c, bool d, int i, Item item, string s, Func<int, int> f)
        {
            bool both = c && Twice(d ? i : 0) > 2;
            bool either = c || Twice(d ? i : 0) > 2;
            string text = s ?? (d ? "a" : "b").Trim();
            _maybe ??= Twice(c ? 1 : 2);
            int x = c ? Twice(d ? 1 : 2) : 0;
            int? size = item?.Parts.IndexOf(c ? 1 : 2);
            Func<int, int> g = y => Twice(c ? y : 0);
            var made = new Item { Size = c ? 1 : 2 };
            var list = new List<int> { d ? 3 : 4 };
            int arm = i switch
            {
                0 => Twice(c ? 1 : 2),
                _ => 0,
            };
            switch (i)
            {
                case 1 when Twice(c ? i : 0) > 0:
                    arm++;
                    break;
            }
            int sum = checked(Twice(c ? i + 1 : i));
            (int first, int second) = (Twice(c ? 1 : 2), 3);
            string holed = $"{Run2(() =>
            {
                return Twice(c ? 1 : 2);
            })}";
            int fixedValue = Twice(Always ? 1 : 2);
            int thrown = Twice(c ? throw new ArgumentException() : throw new InvalidOperationException());
            var anon = Run3(c ? new { A = 1 } : new { A = 2 });
            int whole = c ? i : 0;
            return x + (size ?? 0) + g(i) + made.Size + list.Count + sum + first + second + fixedValue + thrown + anon + whole + holed.Length + Total
                + (_maybe ?? 0);
        }

        static int Run2(Func<int> f)
        {
            return f();
        }

        static int Run3(object o)
        {
            return o.GetHashCode();
        }
    }
}
=== queue
23: an expression body: make it a block first
27: conditionally evaluated: the right side of &&, || or ??
28: conditionally evaluated: the right side of &&, || or ??
29: conditionally evaluated: the right side of &&, || or ??
30: conditionally evaluated: the right side of ??=
31: conditionally evaluated: a branch of ?:
32: conditionally evaluated: the part after ?.
33: conditionally evaluated: a lambda body
34: an object or collection initializer: the constructor and the earlier elements run first
35: an object or collection initializer: the constructor and the earlier elements run first
38: conditionally evaluated: a switch expression arm
43: conditionally evaluated: a when clause
47: inside checked() or unchecked(), which the temporary would be outside of
48: a deconstruction, whose targets' parts run first
51: the statement is inside an interpolation hole, where no statement can go
53: the condition is a constant: an if would leave unreachable code
54: every branch throws: the statement after it would never run
55: an anonymous type, which can't be written
