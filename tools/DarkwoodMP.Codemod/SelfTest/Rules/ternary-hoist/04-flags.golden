Wire flags (guide section 4.6). A chain of | whose ?: are "c ? k : 0"
with constant whole numbers becomes "int flags = 0;" and an if per flag,
inside the cast that was around the chain: the conditions run in the same
order and the value is the same, bit for bit. Another operand is or-ed in
where it was, or starts the flags when it comes first, and the flags take
the type of the whole chain. A ?: that isn't "c ? k : 0", or a | of the
mod's own, is not a flag: each ?: there moves on its own. Flags hold
calls in their conditions like any other code that moves, so a mutable
field read before them keeps them where they are.
=== input
using System;
using System.IO;

namespace N
{
    public struct Bits
    {
        public int Value;

        public static Bits operator |(Bits a, Bits b)
        {
            return new Bits { Value = a.Value | b.Value };
        }
    }

    public class C
    {
        BinaryWriter _out;

        static bool Ready(int i)
        {
            return i > 0;
        }

        public void Run(BinaryWriter w, bool a, bool b, bool d, int i, Bits x, Bits y)
        {
            w.Write((byte)((a ? 1 : 0) | (b ? 2 : 0) | (d ? 4 : 0)));
            w.Write((byte)((a ? 1 : 0) | 2 | (i > 3 ? 8 : 0)));
            int packed = i | (a ? 0x100 : 0);
            long wide = (a ? 1L : 0L) | (b ? 1L << 40 : 0L);
            w.Write((byte)((a ? 1 : 0) | (b ? 3 : 1)));
            Bits both = (a ? x : y) | (b ? y : x);
            _out.Write((byte)((Ready(i) ? 1 : 0) | (b ? 2 : 0)));
            w.Write(packed + wide + both.Value);
        }
    }
}
=== output
using System;
using System.IO;

namespace N
{
    public struct Bits
    {
        public int Value;

        public static Bits operator |(Bits a, Bits b)
        {
            return new Bits { Value = a.Value | b.Value };
        }
    }

    public class C
    {
        BinaryWriter _out;

        static bool Ready(int i)
        {
            return i > 0;
        }

        public void Run(BinaryWriter w, bool a, bool b, bool d, int i, Bits x, Bits y)
        {
            int flags = 0;
            if (a)
            {
                flags |= 1;
            }
            if (b)
            {
                flags |= 2;
            }
            if (d)
            {
                flags |= 4;
            }
            w.Write((byte)flags);
            int flags2 = 0;
            if (a)
            {
                flags2 |= 1;
            }
            flags2 |= 2;
            if (i > 3)
            {
                flags2 |= 8;
            }
            w.Write((byte)flags2);
            int flags3 = i;
            if (a)
            {
                flags3 |= 0x100;
            }
            int packed = flags3;
            long flags4 = 0;
            if (a)
            {
                flags4 |= 1L;
            }
            if (b)
            {
                flags4 |= 1L << 40;
            }
            long wide = flags4;
            int value = 0;
            if (a)
            {
                value = 1;
            }
            int value2 = 1;
            if (b)
            {
                value2 = 3;
            }
            w.Write((byte)(value | value2));
            Bits value3;
            if (a)
            {
                value3 = x;
            }
            else
            {
                value3 = y;
            }
            Bits value4;
            if (b)
            {
                value4 = y;
            }
            else
            {
                value4 = x;
            }
            Bits both = value3 | value4;
            _out.Write((byte)((Ready(i) ? 1 : 0) | (b ? 2 : 0)));
            w.Write(packed + wide + both.Value);
        }
    }
}
=== queue
33: the hoisted code has effects and a mutable value is read earlier: _out
