Statements. The temporary goes in front of the statement that holds the
?:: an expression statement, a declaration (after the declarators before
it), a return, a yield return, a throw, an if condition, a foreach source,
a switch, a lock and a using, a statement of a switch section or of a
block lambda. Each of those runs that part once, first. An else-if
condition, a loop condition and a for header run only sometimes or more
than once, and a foreach source that declares a variable would widen its
scope: those go to the queue. So does a declarator whose ?: reads one
declared before it in the same statement, which doesn't compile once the
?: is in front of it.
=== input
using System;
using System.Collections.Generic;
using System.IO;

namespace N
{
    public class C
    {
        readonly object _gate = new object();

        static int Twice(int value)
        {
            return value * 2;
        }

        static List<int> Items(int count)
        {
            return new List<int> { count };
        }

        static object Pick(object first)
        {
            return first;
        }

        public IEnumerable<int> Steps(bool c, int i)
        {
            yield return Twice(c ? i : 1);
        }

        public int Run(bool c, bool d, int i, object o, List<int> list)
        {
            int n = 0;
            if (Twice(c ? i : 0) > 2)
            {
                n++;
            }
            else if (Twice(d ? i : 0) > 2)
            {
                n--;
            }
            foreach (var x in Items(c ? i : 2))
            {
                n += x;
            }
            foreach (var x in Items(o is int k ? k : 2))
            {
                n += x;
            }
            int p = i, q = Twice(c ? p : 1);
            int r = n, t = Twice(c ? i : 1);
            switch (Twice(d ? i : 1))
            {
                case 2:
                    n = Twice(c ? n : 1);
                    break;
                default:
                    n = 0;
                    break;
            }
            lock (Pick(c ? _gate : list))
            {
                n++;
            }
            using (var stream = new MemoryStream(Twice(c ? 4 : 8)))
            {
                n += (int)stream.Capacity;
            }
            using var other = new MemoryStream(Twice(d ? 4 : 8));
            Action act = () =>
            {
                n += Twice(c ? 1 : 2);
            };
            act();
            while (Twice(c ? n : 0) < 10)
            {
                n++;
            }
            do
            {
                n++;
            }
            while (Twice(d ? n : 0) < 20);
            for (int k2 = 0; k2 < Twice(c ? 2 : 3); k2++)
            {
                n++;
            }
            if (n < 0)
            {
                throw new ArgumentException(c ? "low" : "negative");
            }
            return Twice(d ? n : q + r + t);
        }
    }
}
=== output
using System;
using System.Collections.Generic;
using System.IO;

namespace N
{
    public class C
    {
        readonly object _gate = new object();

        static int Twice(int value)
        {
            return value * 2;
        }

        static List<int> Items(int count)
        {
            return new List<int> { count };
        }

        static object Pick(object first)
        {
            return first;
        }

        public IEnumerable<int> Steps(bool c, int i)
        {
            int value = 1;
            if (c)
            {
                value = i;
            }
            yield return Twice(value);
        }

        public int Run(bool c, bool d, int i, object o, List<int> list)
        {
            int n = 0;
            int value = 0;
            if (c)
            {
                value = i;
            }
            if (Twice(value) > 2)
            {
                n++;
            }
            else if (Twice(d ? i : 0) > 2)
            {
                n--;
            }
            int count = 2;
            if (c)
            {
                count = i;
            }
            foreach (var x in Items(count))
            {
                n += x;
            }
            foreach (var x in Items(o is int k ? k : 2))
            {
                n += x;
            }
            int p = i, q = Twice(c ? p : 1);
            int value3 = 1;
            if (c)
            {
                value3 = i;
            }
            int r = n, t = Twice(value3);
            int value4 = 1;
            if (d)
            {
                value4 = i;
            }
            switch (Twice(value4))
            {
                case 2:
                    int value5 = 1;
                    if (c)
                    {
                        value5 = n;
                    }
                    n = Twice(value5);
                    break;
                default:
                    n = 0;
                    break;
            }
            object first;
            if (c)
            {
                first = _gate;
            }
            else
            {
                first = list;
            }
            lock (Pick(first))
            {
                n++;
            }
            int value6 = 8;
            if (c)
            {
                value6 = 4;
            }
            using (var stream = new MemoryStream(Twice(value6)))
            {
                n += (int)stream.Capacity;
            }
            int value7 = 8;
            if (d)
            {
                value7 = 4;
            }
            using var other = new MemoryStream(Twice(value7));
            Action act = () =>
            {
                int value8 = 2;
                if (c)
                {
                    value8 = 1;
                }
                n += Twice(value8);
            };
            act();
            while (Twice(c ? n : 0) < 10)
            {
                n++;
            }
            do
            {
                n++;
            }
            while (Twice(d ? n : 0) < 20);
            for (int k2 = 0; k2 < Twice(c ? 2 : 3); k2++)
            {
                n++;
            }
            if (n < 0)
            {
                string message = "negative";
                if (c)
                {
                    message = "low";
                }
                throw new ArgumentException(message);
            }
            int value9;
            if (d)
            {
                value9 = n;
            }
            else
            {
                value9 = q + r + t;
            }
            return Twice(value9);
        }
    }
}
=== queue
38: conditionally evaluated: an else-if condition
46: the ?: declares a variable, whose scope would change
50: did not compile: CS0841 Cannot use local variable 'p' before it is declared
75: conditionally evaluated: a loop condition
83: conditionally evaluated: a loop condition
84: conditionally evaluated: a for header
