Layout and comments. A statement of several lines keeps the column it
starts at, so the lines that continue it stay where they were, and the
comment behind it stays behind it. A comment inside a branch moves with
the branch. One on the ? or the :, which would be lost, and a directive
inside the statement send the statement to the queue.
=== input
using System;

namespace N
{
    public class C
    {
        static void Log(string text)
        {
        }

        static string Pick(string text)
        {
            return text;
        }

        public void Run(bool c, bool d, int i)
        {
            Log($"first part {(c ? "on" : "off")}, "
                + $"second part {i}");
            Log(c ? "near" : "far"); // what the player sees
            Log(c ? Pick(/* the short one */ "a") : "b");
            Log(c ? /* on the ? */ "a" : "b");
            Log(d ? "x" // the long one
                : "y");
            Log(c ? "p" :
#if DEBUG
                "q");
#else
                "r");
#endif
        }
    }
}
=== output
using System;

namespace N
{
    public class C
    {
        static void Log(string text)
        {
        }

        static string Pick(string text)
        {
            return text;
        }

        public void Run(bool c, bool d, int i)
        {
            string text = "off";
            if (c)
            {
                text = "on";
            }
            Log($"first part {text}, "
                + $"second part {i}");
            string text2 = "far";
            if (c)
            {
                text2 = "near";
            }
            Log(text2); // what the player sees
            string text3 = "b";
            if (c)
            {
                text3 = Pick(/* the short one */ "a");
            }
            Log(text3);
            Log(c ? /* on the ? */ "a" : "b");
            Log(d ? "x" // the long one
                : "y");
            Log(c ? "p" :
#if DEBUG
                "q");
#else
                "r");
#endif
        }
    }
}
=== queue
22: a comment inside the statement would be lost
23: a comment inside the statement would be lost
25: a preprocessor directive inside the statement
