A receiver that isn't a local, a parameter or this is read once, into a
temporary: a member of another type, a call, a field of this, also when
written this._box, a ref parameter or ref local, and a local or parameter
that a lambda or a local function captures, which another thread can change
between two reads. A lambda's own parameter, a local the lambda declares
and a parameter of an expression body that nothing captures are read
directly. The comment
behind a rewritten statement goes on a line of its own above the new code,
at the statement's indentation, also when the line above ends in a comment
of its own.
=== input
using System;
using System.Threading;

namespace N
{
    public class Box
    {
        public static Box Instance { get; set; }

        public int N;

        public void Hit(int k)
        {
            N += k;
        }
    }

    public class C
    {
        Box _box;

        static Box Make()
        {
            return Box.Instance;
        }

        public void Run(Box a)
        {
            Box.Instance?.Hit(1);
            Make()?.Hit(2);
            a.Hit(3); // the first: a comment behind it
            Box.Instance?.Hit(4); // the second, behind the ?.
            a.Hit(5);
        }

        public void Hit(ref Box b)
        {
            b?.Hit(2);
            ref Box held = ref _box;
            held?.Hit(3);
        }

        public void Own()
        {
            this._box?.Hit(6);
        }

        public void Shared(Box p)
        {
            Box b = new Box();
            var t = new Thread(() =>
            {
                b = null;
                p = null;
            });
            t.Start();
            b?.Hit(1);
            p?.Hit(2);
        }

        public void Later(Box q)
        {
            void Clear()
            {
                q = null;
            }

            Action clear = Clear;
            q?.Hit(3);
            clear();
        }

        public void Pass(Box r) => Send(() => r?.Hit(4));

        public void Tap(Box s) => s?.Hit(5);

        public void Each(Box[] all)
        {
            Array.ForEach(all, x =>
            {
                Box y = x;
                y?.Hit(6);
                x?.Hit(7);
            });
        }

        static readonly Action<Box> Hits = z => z?.Hit(8);

        static void Send(Action act)
        {
            act();
        }
    }
}
=== output
using System;
using System.Threading;

namespace N
{
    public class Box
    {
        public static Box Instance { get; set; }

        public int N;

        public void Hit(int k)
        {
            N += k;
        }
    }

    public class C
    {
        Box _box;

        static Box Make()
        {
            return Box.Instance;
        }

        public void Run(Box a)
        {
            Box instance = Box.Instance;
            if (instance != null)
            {
                instance.Hit(1);
            }
            Box box = Make();
            if (box != null)
            {
                box.Hit(2);
            }
            a.Hit(3); // the first: a comment behind it
            // the second, behind the ?.
            Box instance2 = Box.Instance;
            if (instance2 != null)
            {
                instance2.Hit(4);
            }
            a.Hit(5);
        }

        public void Hit(ref Box b)
        {
            Box b2 = b;
            if (b2 != null)
            {
                b2.Hit(2);
            }
            ref Box held = ref _box;
            Box held2 = held;
            if (held2 != null)
            {
                held2.Hit(3);
            }
        }

        public void Own()
        {
            Box box = this._box;
            if (box != null)
            {
                box.Hit(6);
            }
        }

        public void Shared(Box p)
        {
            Box b = new Box();
            var t = new Thread(() =>
            {
                b = null;
                p = null;
            });
            t.Start();
            Box b2 = b;
            if (b2 != null)
            {
                b2.Hit(1);
            }
            Box p2 = p;
            if (p2 != null)
            {
                p2.Hit(2);
            }
        }

        public void Later(Box q)
        {
            void Clear()
            {
                q = null;
            }

            Action clear = Clear;
            Box q2 = q;
            if (q2 != null)
            {
                q2.Hit(3);
            }
            clear();
        }

        public void Pass(Box r) => Send(() =>
        {
            Box r2 = r;
            if (r2 != null)
            {
                r2.Hit(4);
            }
        });

        public void Tap(Box s)
        {
            if (s != null)
            {
                s.Hit(5);
            }
        }

        public void Each(Box[] all)
        {
            Array.ForEach(all, x =>
            {
                Box y = x;
                if (y != null)
                {
                    y.Hit(6);
                }
                if (x != null)
                {
                    x.Hit(7);
                }
            });
        }

        static readonly Action<Box> Hits = z =>
        {
            if (z != null)
            {
                z.Hit(8);
            }
        };

        static void Send(Action act)
        {
            act();
        }
    }
}
