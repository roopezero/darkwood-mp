A comparison on one ?. keeps its place as a fixed translation, which works
in a loop condition, a when clause and the right side of &&, where no
statement can go. It is put in parentheses where the code around it would
bind it another way. A receiver that isn't a local goes into a temporary in
front of the statement first, where that is allowed, and goes to the queue
where it isn't. A compared value that may have effects or be null, == null
on a member of a value type, a member whose type has an == of its own and a
chain take a temporary instead, and a comparison that can't take either
goes to the queue.
=== input
namespace N
{
    public class Box
    {
        public Box Next;
        public int Count;
        public int? Size;
        public bool Open;
        public bool? Shut;
        public string Label;
        public Money Price;
    }

    public class Money
    {
        public static bool operator ==(Money a, Money b)
        {
            return ReferenceEquals(a, b);
        }

        public static bool operator !=(Money a, Money b)
        {
            return !ReferenceEquals(a, b);
        }

        public override bool Equals(object o)
        {
            return ReferenceEquals(this, o);
        }

        public override int GetHashCode()
        {
            return 0;
        }
    }

    public enum Kind
    {
        A,
        B,
    }

    public class C
    {
        static Box s_box;
        const int Limit = 4;

        static Box Shared => s_box;

        int Next()
        {
            return 3;
        }

        public int Run(Box a, Box b, int n, int? m, bool c, string s, Kind k)
        {
            int hits = 0;
            if (a?.Count == 5)
            {
                hits++;
            }
            if (a?.Count != n)
            {
                hits++;
            }
            if (a?.Count > Limit || a?.Count <= 1 || 2 >= a?.Count)
            {
                hits++;
            }
            if (a?.Next == null && a?.Label != null)
            {
                hits++;
            }
            if (a?.Size == null || a?.Size >= 3)
            {
                hits++;
            }
            if (a?.Open == true || a?.Open != true || a?.Open == false
                || a?.Open != false || true == a?.Open)
            {
                hits++;
            }
            if (a?.Shut == true)
            {
                hits++;
            }
            bool open = a?.Open ?? false;
            bool closed = a?.Open ?? true;
            bool both = !(a?.Label == "x") && c != a?.Open;
            hits += (a?.Count == 1 ? 1 : 0);
            while (b?.Next != null)
            {
                b = b.Next;
            }
            if (c && a?.Count == 2)
            {
                hits++;
            }
            if (Shared?.Count == 3)
            {
                hits++;
            }
            if (c && Shared?.Count == 4)
            {
                hits++;
            }
            if (a?.Count == Next())
            {
                hits++;
            }
            if (a?.Count == m)
            {
                hits++;
            }
            if (a?.Count == null)
            {
                hits++;
            }
            if (a?.Label == s)
            {
                hits++;
            }
            if (a?.Price == null)
            {
                hits++;
            }
            if (a?.Next?.Count == 2)
            {
                hits++;
            }
            if (k == Kind.A && a?.Count == (int)Kind.B)
            {
                hits++;
            }
            return hits + (open ? 1 : 0) + (closed ? 1 : 0) + (both ? 1 : 0);
        }

        public bool Seen(Box a) => a?.Count == 0;

        public bool Loop(Box a, bool c)
        {
            while (c && Shared?.Open == true)
            {
                c = false;
            }
            return c;
        }
    }
}
=== output
namespace N
{
    public class Box
    {
        public Box Next;
        public int Count;
        public int? Size;
        public bool Open;
        public bool? Shut;
        public string Label;
        public Money Price;
    }

    public class Money
    {
        public static bool operator ==(Money a, Money b)
        {
            return ReferenceEquals(a, b);
        }

        public static bool operator !=(Money a, Money b)
        {
            return !ReferenceEquals(a, b);
        }

        public override bool Equals(object o)
        {
            return ReferenceEquals(this, o);
        }

        public override int GetHashCode()
        {
            return 0;
        }
    }

    public enum Kind
    {
        A,
        B,
    }

    public class C
    {
        static Box s_box;
        const int Limit = 4;

        static Box Shared => s_box;

        int Next()
        {
            return 3;
        }

        public int Run(Box a, Box b, int n, int? m, bool c, string s, Kind k)
        {
            int hits = 0;
            if (a != null && a.Count == 5)
            {
                hits++;
            }
            if (a == null || a.Count != n)
            {
                hits++;
            }
            if ((a != null && a.Count > Limit) || (a != null && a.Count <= 1) || (a != null && 2 >= a.Count))
            {
                hits++;
            }
            if ((a == null || a.Next == null) && a != null && a.Label != null)
            {
                hits++;
            }
            if (a == null || a.Size == null || (a != null && a.Size >= 3))
            {
                hits++;
            }
            if ((a != null && a.Open) || a == null || !a.Open || (a != null && !a.Open)
                || a == null || a.Open || (a != null && a.Open))
            {
                hits++;
            }
            if (a != null && a.Shut == true)
            {
                hits++;
            }
            bool open = a != null && a.Open;
            bool closed = a == null || a.Open;
            bool both = !(a != null && a.Label == "x") && (a == null || c != a.Open);
            hits += ((a != null && a.Count == 1) ? 1 : 0);
            while (b != null && b.Next != null)
            {
                b = b.Next;
            }
            if (c && a != null && a.Count == 2)
            {
                hits++;
            }
            Box shared = Shared;
            if (shared != null && shared.Count == 3)
            {
                hits++;
            }
            if (c && Shared?.Count == 4)
            {
                hits++;
            }
            int? count = null;
            if (a != null)
            {
                count = a.Count;
            }
            if (count == Next())
            {
                hits++;
            }
            int? count2 = null;
            if (a != null)
            {
                count2 = a.Count;
            }
            if (count2 == m)
            {
                hits++;
            }
            int? count3 = null;
            if (a != null)
            {
                count3 = a.Count;
            }
            if (count3 == null)
            {
                hits++;
            }
            string label = null;
            if (a != null)
            {
                label = a.Label;
            }
            if (label == s)
            {
                hits++;
            }
            Money price = null;
            if (a != null)
            {
                price = a.Price;
            }
            if (price == null)
            {
                hits++;
            }
            int? count4 = null;
            if (a != null)
            {
                Box next = a.Next;
                if (next != null)
                {
                    count4 = next.Count;
                }
            }
            if (count4 == 2)
            {
                hits++;
            }
            if (k == Kind.A && a != null && a.Count == (int)Kind.B)
            {
                hits++;
            }
            return hits + (open ? 1 : 0) + (closed ? 1 : 0) + (both ? 1 : 0);
        }

        public bool Seen(Box a) => a != null && a.Count == 0;

        public bool Loop(Box a, bool c)
        {
            while (c && Shared?.Open == true)
            {
                c = false;
            }
            return c;
        }
    }
}
