A comparison whose operator is a user-defined one that isn't lifted moves
into a temporary: the original calls that operator with the null of a null
receiver, and Gauge's "==(int?, Gauge)", "!=" and "<" say what that gives,
not the fixed translation. A lifted operator, which a null never reaches,
the == of string, .NET and a Unity object and the == of a Nullable tuple,
which is false for a null before any element is compared, keep their
translations. Meter's "==(Meter?, Meter?)" gets the null too, so "h?.M ==
null" moves into a temporary. "h?.It == this" calls the reference ==,
since an Owner doesn't convert to an Item, so Item's own == doesn't count
and the translation holds; a this that is a Unity object isn't "not null",
because Unity's == counts a destroyed one as null, so "h?.Go == this"
moves into a temporary.
=== input
using System;

namespace UnityEngine
{
    public class Object
    {
        public static bool operator ==(Object a, Object b)
        {
            return ReferenceEquals(a, b);
        }

        public static bool operator !=(Object a, Object b)
        {
            return !ReferenceEquals(a, b);
        }

        public override bool Equals(object o)
        {
            return ReferenceEquals(this, o);
        }

        public override int GetHashCode()
        {
            return 0;
        }
    }

    public class GameObject : Object
    {
    }
}

namespace N
{
    using UnityEngine;

    public struct Gauge
    {
        public int V;

        public static bool operator ==(int? a, Gauge b)
        {
            return !a.HasValue || a.Value == b.V;
        }

        public static bool operator !=(int? a, Gauge b)
        {
            return !(a == b);
        }

        public static bool operator <(int? a, Gauge b)
        {
            return !a.HasValue || a.Value < b.V;
        }

        public static bool operator >(int? a, Gauge b)
        {
            return a.HasValue && a.Value > b.V;
        }

        public override bool Equals(object o)
        {
            return false;
        }

        public override int GetHashCode()
        {
            return 0;
        }
    }

    public struct Span
    {
        public int V;

        public static bool operator ==(Span a, Span b)
        {
            return a.V == b.V;
        }

        public static bool operator !=(Span a, Span b)
        {
            return a.V != b.V;
        }

        public override bool Equals(object o)
        {
            return false;
        }

        public override int GetHashCode()
        {
            return 0;
        }
    }

    public struct Meter
    {
        public int V;

        public static bool operator ==(Meter? a, Meter? b)
        {
            return false;
        }

        public static bool operator !=(Meter? a, Meter? b)
        {
            return true;
        }

        public override bool Equals(object o)
        {
            return false;
        }

        public override int GetHashCode()
        {
            return 0;
        }
    }

    public class Owner
    {
        public bool Mine(Holder h)
        {
            bool mine = h?.It == this;
            bool other = h?.It != this;
            return mine && other;
        }
    }

    public class Item : Owner
    {
        public static bool operator ==(Item a, Item b)
        {
            return true;
        }

        public static bool operator !=(Item a, Item b)
        {
            return false;
        }

        public override bool Equals(object o)
        {
            return false;
        }

        public override int GetHashCode()
        {
            return 0;
        }
    }

    public class Holder
    {
        public int Count;
        public Span Gap;
        public string Label;
        public Type Kind;
        public GameObject Go;
        public (int, int) Pair;
        public Meter? M;
        public Item It;
    }

    public class Mono : GameObject
    {
        public bool Mine(Holder h)
        {
            bool mine = h?.Go == this;
            bool other = h?.Go != this;
            return mine && other;
        }
    }

    public class C
    {
        public bool Run(Holder h, Gauge g, Span s, (int, int) t)
        {
            bool same = h?.Count == g;
            bool apart = h?.Count != g;
            bool less = h?.Count < g;
            bool gap = h?.Gap == s;
            bool label = h?.Label == "x";
            bool kind = h?.Kind == typeof(int);
            bool gone = h?.Go == null;
            bool pair = h?.Pair == t;
            return same && apart && less && gap && label && kind && gone
                && pair;
        }

        public bool None(Holder h)
        {
            bool none = h?.M == null;
            return none;
        }
    }
}
=== output
using System;

namespace UnityEngine
{
    public class Object
    {
        public static bool operator ==(Object a, Object b)
        {
            return ReferenceEquals(a, b);
        }

        public static bool operator !=(Object a, Object b)
        {
            return !ReferenceEquals(a, b);
        }

        public override bool Equals(object o)
        {
            return ReferenceEquals(this, o);
        }

        public override int GetHashCode()
        {
            return 0;
        }
    }

    public class GameObject : Object
    {
    }
}

namespace N
{
    using UnityEngine;

    public struct Gauge
    {
        public int V;

        public static bool operator ==(int? a, Gauge b)
        {
            return !a.HasValue || a.Value == b.V;
        }

        public static bool operator !=(int? a, Gauge b)
        {
            return !(a == b);
        }

        public static bool operator <(int? a, Gauge b)
        {
            return !a.HasValue || a.Value < b.V;
        }

        public static bool operator >(int? a, Gauge b)
        {
            return a.HasValue && a.Value > b.V;
        }

        public override bool Equals(object o)
        {
            return false;
        }

        public override int GetHashCode()
        {
            return 0;
        }
    }

    public struct Span
    {
        public int V;

        public static bool operator ==(Span a, Span b)
        {
            return a.V == b.V;
        }

        public static bool operator !=(Span a, Span b)
        {
            return a.V != b.V;
        }

        public override bool Equals(object o)
        {
            return false;
        }

        public override int GetHashCode()
        {
            return 0;
        }
    }

    public struct Meter
    {
        public int V;

        public static bool operator ==(Meter? a, Meter? b)
        {
            return false;
        }

        public static bool operator !=(Meter? a, Meter? b)
        {
            return true;
        }

        public override bool Equals(object o)
        {
            return false;
        }

        public override int GetHashCode()
        {
            return 0;
        }
    }

    public class Owner
    {
        public bool Mine(Holder h)
        {
            bool mine = h != null && h.It == this;
            bool other = h == null || h.It != this;
            return mine && other;
        }
    }

    public class Item : Owner
    {
        public static bool operator ==(Item a, Item b)
        {
            return true;
        }

        public static bool operator !=(Item a, Item b)
        {
            return false;
        }

        public override bool Equals(object o)
        {
            return false;
        }

        public override int GetHashCode()
        {
            return 0;
        }
    }

    public class Holder
    {
        public int Count;
        public Span Gap;
        public string Label;
        public Type Kind;
        public GameObject Go;
        public (int, int) Pair;
        public Meter? M;
        public Item It;
    }

    public class Mono : GameObject
    {
        public bool Mine(Holder h)
        {
            GameObject go = null;
            if (h != null)
            {
                go = h.Go;
            }
            bool mine = go == this;
            GameObject go2 = null;
            if (h != null)
            {
                go2 = h.Go;
            }
            bool other = go2 != this;
            return mine && other;
        }
    }

    public class C
    {
        public bool Run(Holder h, Gauge g, Span s, (int, int) t)
        {
            int? count = null;
            if (h != null)
            {
                count = h.Count;
            }
            bool same = count == g;
            int? count2 = null;
            if (h != null)
            {
                count2 = h.Count;
            }
            bool apart = count2 != g;
            int? count3 = null;
            if (h != null)
            {
                count3 = h.Count;
            }
            bool less = count3 < g;
            bool gap = h != null && h.Gap == s;
            bool label = h != null && h.Label == "x";
            bool kind = h != null && h.Kind == typeof(int);
            bool gone = h == null || h.Go == null;
            bool pair = h != null && h.Pair == t;
            return same && apart && less && gap && label && kind && gone
                && pair;
        }

        public bool None(Holder h)
        {
            Meter? m = null;
            if (h != null)
            {
                m = h.M;
            }
            bool none = m == null;
            return none;
        }
    }
}
