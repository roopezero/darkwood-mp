Anywhere else a chain moves into a temporary of its natural type in front
of its statement: an argument, named after the parameter, an operand, an
interpolation hole, which keeps its format, an if condition and a target
with an element. Two of them move in the order they run. The hazard rules
of ternary-hoist send to the queue a ?. that a call runs before, and one
with effects that a mutable value is read before, a field alone too; so
does an assignment whose target's parts are such a call or value. For an
earlier operand that isn't a call itself, a ?: in parentheses in an
earlier hole too, the queue names the first call, getter or operator in it
(with the operator's type), or the value made into text, cut to about 60
characters. Code that may not run (the right side of &&, a branch of ?:, a
lambda body, a loop condition, an else-if condition), a ?. inside another
or holding one, a variable declared inside it, a comment on ?., an
initializer, an await and a field initializer go to the queue.
=== input
using System;
using System.Collections.Generic;
using System.Threading.Tasks;

namespace N
{
    public class Box
    {
        public Box Next;
        public string Label;
        public int Count;
        public Dictionary<string, string> Tags;

        public string Take()
        {
            Count++;
            return Label;
        }

        public bool Find(string key, out string value)
        {
            value = key;
            return true;
        }

        public Task<int> Wait()
        {
            return Task.FromResult(Count);
        }
    }

    public class Line
    {
        public string Text;
    }

    public class C
    {
        static readonly string s_field = new Box()?.Label;
        int _seen;

        static void Show(string label, int? count)
        {
        }

        int Seen()
        {
            return _seen++;
        }

        public async Task<int> Run(Box a, Box b, bool c, List<Box> boxes)
        {
            Show(a?.Label, b?.Count);
            var line = "box " + a?.Label + $" has {a?.Count:000} things";
            if (a?.Label.Length > 2)
            {
                _seen++;
            }
            var tags = new Dictionary<string, string>();
            tags["first"] = a?.Label;
            Show(Seen().ToString(), a?.Count);
            Show(_seen.ToString(), a?.Take().Length);
            bool both = c && a?.Label.Length > 0;
            var pick = c ? a?.Label : "none";
            boxes.ForEach(x => Show(x?.Label, 0));
            while (a?.Next?.Next != null)
            {
                a = a.Next;
            }
            var inner = a?.Next?.Label + b?.Next.Take()?.Trim();
            var outer = a?.Next.Take()?.Insert(0, b?.Label);
            var found = a?.Find("k", out var value);
            var noted = a /* kept */ ?.Label;
            var made = new Line { Text = a?.Label };
            int waited = await a?.Wait();
            return line.Length + waited + pick.Length + both.GetHashCode()
                + inner.Length + outer.Length + found.GetHashCode()
                + noted.Length + made.Text.Length;
        }

        int _n;
        Worker _last;

        static void Use(int n, int? bumped)
        {
        }

        static Worker Make()
        {
            return new Worker();
        }

        static string Describe(string first, string second, string third)
        {
            return first + second + third;
        }

        public int Later(Worker w, Box a, Purse p, bool c)
        {
            Use(_n, w?.Bumped);
            if (c)
            {
                _n++;
            }
            else if (Holder.Current?.Busy == true)
            {
                _n--;
            }
            else if (Make()?.Count > 0)
            {
                _n += 2;
            }
            _last.Size = Make()?.Count;
            Holder.Next.Size = _last?.Count;
            Show($"seen {Seen()} times", a?.Count);
            Show("bumped " + w.Bumped, a?.Count);
            Show("next " + Holder.Next.Bumped, a?.Count);
            Show(p != null ? "purse" : "none", a?.Count);
            Show("purse " + p, a?.Count);
            Show($"{(p != null ? "purse" : "none")} has {a?.Count}", 0);
            Show(Describe("a long first argument", "a second one",
                "and a third") + "!", a?.Count);
            return _n;
        }
    }

    public class Worker
    {
        public bool Busy;
        public int Count;
        public int? Size;

        public int Bumped
        {
            get
            {
                Count++;
                return Count;
            }
        }
    }

    public static class Holder
    {
        static int s_reads;
        static Worker s_next = new Worker();

        public static Worker Current { get; set; }

        public static Worker Next
        {
            get
            {
                s_reads++;
                return s_next;
            }
        }
    }

    public class Purse
    {
        public static bool operator ==(Purse a, Purse b)
        {
            return ReferenceEquals(a, b);
        }

        public static bool operator !=(Purse a, Purse b)
        {
            return !ReferenceEquals(a, b);
        }

        public override bool Equals(object o)
        {
            return ReferenceEquals(this, o);
        }

        public override int GetHashCode()
        {
            return 0;
        }
    }
}
