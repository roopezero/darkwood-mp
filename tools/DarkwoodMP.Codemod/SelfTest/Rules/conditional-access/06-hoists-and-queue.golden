using System.Collections.Generic;
using System.Threading.Tasks;

namespace N
{
    public class Box
    {
        public Box Next;
        public string Label;
        public int Count;
        public Dictionary<string, string> Tags;

        public string Take()
        {
            Count++;
            return Label;
        }

        public bool Find(string key, out string value)
