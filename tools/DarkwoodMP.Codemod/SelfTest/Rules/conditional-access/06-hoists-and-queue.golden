            }
            int? count2 = null;
            if (a != null)
            {
                count2 = a.Count;
            }
            var line = "box " + label2 + $" has {count2:000} things";
            if (a != null && a.Label.Length > 2)
            {
                _seen++;
            }
            var tags = new Dictionary<string, string>();
            string label3 = null;
            if (a != null)
            {
                label3 = a.Label;
            }
            tags["first"] = label3;
            Show(Seen().ToString(), a?.Count);
            Show(_seen.ToString(), a?.Take().Length);
