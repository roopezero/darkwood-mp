Three statements the rule leaves alone, with the reason each gets in the
queue: a ?. in a statement with an await, whose temporary could become a
field of the state machine; a ?. statement in a lambda's block inside an
interpolation hole, where no statement can go; and a ?. in a for
initializer, which runs once, but declares its variable in the header.
=== input
using System;
using System.Threading.Tasks;

namespace N
{
    public class Box
    {
        public static Box Instance { get; set; }

        public Box Next;

        public void Hit(int k)
        {
        }

        public Type Kind()
        {
            return typeof(Box);
        }
    }

    public class C
    {
        static string Show(Func<int> f)
        {
            return "" + f();
        }

        public async Task Wait()
        {
            Box.Instance?.Hit(await Task.FromResult(4));
        }

        public string Label(Box a)
        {
            return $"at {Show(() =>
            {
                a?.Hit(1);
                return 2;
            })}";
        }

        public int Walk(Box a)
        {
            int n = 0;
            for (var t = a?.Next?.Kind(); t != null; t = t.BaseType)
            {
                n++;
            }
            return n;
        }

        public void Run(Box a)
        {
            a?.Hit(5);
        }
    }
}
=== output
using System;
using System.Threading.Tasks;

namespace N
{
    public class Box
    {
        public static Box Instance { get; set; }

        public Box Next;

        public void Hit(int k)
        {
        }

        public Type Kind()
        {
            return typeof(Box);
        }
    }

    public class C
    {
        static string Show(Func<int> f)
        {
            return "" + f();
        }

        public async Task Wait()
        {
            Box.Instance?.Hit(await Task.FromResult(4));
        }

        public string Label(Box a)
        {
            return $"at {Show(() =>
            {
                a?.Hit(1);
                return 2;
            })}";
        }

        public int Walk(Box a)
        {
            int n = 0;
            for (var t = a?.Next?.Kind(); t != null; t = t.BaseType)
            {
                n++;
            }
            return n;
        }

        public void Run(Box a)
        {
            if (a != null)
            {
                a.Hit(5);
            }
        }
    }
}
=== queue
31: an await in the statement: a temporary could become a field of the state machine
38: inside an interpolation hole, where no statement can go
46: a for initializer: its variable is declared in the header
