The types of the values a chain tests decide. A Unity object anywhere in a
chain leaves it whole for stage 7, not queued, and a Unity member in a
comparison keeps Unity's ==. A receiver whose type has an == of its own
goes to the queue unless that == is .NET's, as Type's is, which treats only
null as null; so do a Nullable receiver, a type parameter and dynamic. An
interface and object stay reference checks, as ?. makes them.
=== input
using System;

namespace UnityEngine
{
    public class Object
    {
        public static bool operator ==(Object a, Object b)
        {
            return ReferenceEquals(a, b);
        }

        public static bool operator !=(Object a, Object b)
        {
            return !ReferenceEquals(a, b);
        }

        public override bool Equals(object o)
        {
            return ReferenceEquals(this, o);
        }

        public override int GetHashCode()
        {
            return 0;
        }
    }

    public class GameObject : Object
    {
        public string name;
        public Holder holder;
    }

    public class Holder
    {
        public GameObject root;
        public string tag;
    }
}

namespace N
{
    using UnityEngine;

    public class Money
    {
        public string Code;

        public static bool operator ==(Money a, Money b)
        {
            return ReferenceEquals(a, b);
        }

        public static bool operator !=(Money a, Money b)
        {
            return !ReferenceEquals(a, b);
        }

        public override bool Equals(object o)
        {
            return ReferenceEquals(this, o);
        }

        public override int GetHashCode()
        {
            return 0;
        }
    }

    public interface IShape
    {
        string Name { get; }
    }

    public struct Point
    {
        public int X;
    }

    public class C
    {
        public object Run(
            GameObject go, Holder h, Money m, IShape s, object o, Type t,
            Point? p, dynamic d)
        {
            var a = go?.name;
            var b = h?.root?.name;
            var c = go?.holder?.tag;
            var e = h?.tag;
            bool f = h?.root != null;
            var g = m?.Code;
            var i = s?.Name;
            var j = o?.ToString();
            var k = t?.Name;
            var l = p?.X;
            object n = d?.Name;
            return (a, b, c, e, f, g, i, j, k, l, n);
        }

        public string Name<T>(T value) where T : class
        {
            return value?.ToString();
        }
    }
}
=== output
using System;

namespace UnityEngine
{
    public class Object
    {
        public static bool operator ==(Object a, Object b)
        {
            return ReferenceEquals(a, b);
        }

        public static bool operator !=(Object a, Object b)
        {
            return !ReferenceEquals(a, b);
        }

        public override bool Equals(object o)
        {
            return ReferenceEquals(this, o);
        }

        public override int GetHashCode()
        {
            return 0;
        }
    }

    public class GameObject : Object
    {
        public string name;
        public Holder holder;
    }

    public class Holder
    {
        public GameObject root;
        public string tag;
    }
}

namespace N
{
    using UnityEngine;

    public class Money
    {
        public string Code;

        public static bool operator ==(Money a, Money b)
        {
            return ReferenceEquals(a, b);
        }

        public static bool operator !=(Money a, Money b)
        {
            return !ReferenceEquals(a, b);
        }

        public override bool Equals(object o)
        {
            return ReferenceEquals(this, o);
        }

        public override int GetHashCode()
        {
            return 0;
        }
    }

    public interface IShape
    {
        string Name { get; }
    }

    public struct Point
    {
        public int X;
    }

    public class C
    {
        public object Run(
            GameObject go, Holder h, Money m, IShape s, object o, Type t,
            Point? p, dynamic d)
        {
            var a = go?.name;
            var b = h?.root?.name;
            var c = go?.holder?.tag;
            string e = null;
            if (h != null)
            {
                e = h.tag;
            }
            bool f = h != null && h.root != null;
            var g = m?.Code;
            string i = null;
            if (s != null)
            {
                i = s.Name;
            }
            string j = null;
            if (o != null)
            {
                j = o.ToString();
            }
            string k = null;
            if (t != null)
            {
                k = t.Name;
            }
            var l = p?.X;
            object n = d?.Name;
            return (a, b, c, e, f, g, i, j, k, l, n);
        }

        public string Name<T>(T value) where T : class
        {
            return value?.ToString();
        }
    }
}
=== queue
91: a receiver whose type has an == of its own, which "x != null" would call
95: a Nullable receiver, which ?. reads through its Value
96: a dynamic receiver
102: a receiver of a type parameter
