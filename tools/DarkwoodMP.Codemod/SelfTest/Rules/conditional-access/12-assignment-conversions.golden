An assignment whose target takes the value by a user-defined conversion
keeps the conversion: the value moves into a temporary in front, and the
target gets the temporary, so the operator still runs for a null
receiver, as it did before. The assignment form would store null in the
target instead.
=== input
namespace N
{
    public class Wrap
    {
        public string S;

        public static implicit operator Wrap(string s)
        {
            return new Wrap { S = s };
        }
    }

    public class Box
    {
        public string Name;
    }

    public class C
    {
        Wrap _wrap;

        public void Set(Box a, Wrap w)
        {
            w = a?.Name;
            _wrap = a?.Name;
        }
    }
}
=== output
namespace N
{
    public class Wrap
    {
        public string S;

        public static implicit operator Wrap(string s)
        {
            return new Wrap { S = s };
        }
    }

    public class Box
    {
        public string Name;
    }

    public class C
    {
        Wrap _wrap;

        public void Set(Box a, Wrap w)
        {
            string w2 = null;
            if (a != null)
            {
                w2 = a.Name;
            }
            w = w2;
            string wrap = null;
            if (a != null)
            {
                wrap = a.Name;
            }
            _wrap = wrap;
        }
    }
}
=== queue
