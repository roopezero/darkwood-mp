Every kind of place rule DW0007 checks, and the ones it doesn't.
=== input
using System;
using System.Collections.Generic;
using System.Linq;

namespace Golden
{
    class Places
    {
        int _count;
        int Count
        {
            get
            {
                return _count;
            }
            set
            {
                _count = value;
            }
        }
        int Plain { get; set; }
        void Run(List<int> items, Action<Action> each)
        {
            if (_count > 0)
            {
                _count--;
            }
            else
            {
                _count++;
            }
            try
            {
                _count = items[0];
            }
            catch (Exception)
            {
                _count = 0;
            }
            finally
            {
                _count++;
            }
            do
            {
                _count--;
            }
            while (_count > 10);
            each(() =>
            {
                _count = 1;
            });
            var big = items.Where(i =>
            {
                return i > 0;
            })
                .ToList();
            // A comment line isn't a blank line.
            foreach (var item in items)
            {
                _count += item;
            }
#if DEBUG
            _count = 2;
#endif
            var name = $"{_count} {new Places { Plain = 1 }.Plain}";
            switch (_count)
            {
                case 1:
                    {
                        _count = 3;
                        break;
                    }
                case 2:
                    _count = 4;
                    break;
            }
            void Local()
            {
                _count = 5;
            }
            Local();
            if (_count == 6)
            {
                return;
            }
        }
        void Last()
        {
        }
    }
    class Next
    {
    }
}
