=== input
using System;
using System.Text;

class Splits
{
    static string Name(int n)
    {
        return "n" + n;
    }

    static void Log(string text)
    {
        Console.WriteLine(text);
    }

    static string Show(string key, int count, double ratio, object thing)
    {
        Log($"a log line about {key}, with {count} things and a ratio of {ratio:0.00}, then {thing}");
        Log($"a hole with an alignment {count,8} and a format {ratio,-6:F1} in a long line, at its end");
        var text = $"a line {key} whose tail has no hole at all, so the tail becomes a plain string";
        var braces = $"{count} in the head, then {{braces}} in a tail with no hole, so they become {{single}} ones";
        int length = $"a receiver string {key} that is long enough to be split, with Length behind".Length;
        Func<int, string> shown = n => $"a lambda's body {n} that is long enough to be split at a space here";
        var verbatim = $@"C:\a verbatim path {key}\that is long enough\to cross the limit\at a space.txt";
        return text + braces + length + shown(count) + verbatim;
    }
}
=== split
using System;
using System.Text;

class Splits
{
    static string Name(int n)
    {
        return "n" + n;
    }

    static void Log(string text)
    {
        Console.WriteLine(text);
    }

    static string Show(string key, int count, double ratio, object thing)
    {
        Log(
            $"a log line about {key}, with {count} things and a ratio of "
                + $"{ratio:0.00}, then {thing}");
        Log(
            $"a hole with an alignment {count,8} and a format {ratio,-6:F1} in "
                + "a long line, at its end");
        var text =
            $"a line {key} whose tail has no hole at all, so the tail becomes "
                + "a plain string";
        var braces =
            $"{count} in the head, then {{braces}} in a tail with no hole, so "
                + "they become {single} ones";
        int length =
            ($"a receiver string {key} that is long enough to be split, with "
                + "Length behind").Length;
        Func<int, string> shown = n =>
            $"a lambda's body {n} that is long enough to be split at a space "
                + "here";
        var verbatim =
            $@"C:\a verbatim path {key}\that is long enough\to cross the "
                + @"limit\at a space.txt";
        return text + braces + length + shown(count) + verbatim;
    }
}
