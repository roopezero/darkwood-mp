=== input
using System;
using System.Collections.Generic;

class Lambdas
{
    void F(List<int> list)
    {
        list.ForEach(x => { Console.WriteLine(x); });
        list.Sort((a, b) => { return a - b; });
        Action nothing = () => { };
        Action<int> one = x => { if (x > 0) return; Console.WriteLine(x); };
        Func<int, int> twice = x => { x++; return x * 2; };
        Action old = delegate { Console.WriteLine(1); };
        list.ForEach(x => list.ForEach(y => { Console.WriteLine(x + y); }));
        if (list.Count > 0) list.ForEach(x => { Console.WriteLine(x); });
        list.RemoveAll(x => x > 0);
    }
}
=== braces
using System;
using System.Collections.Generic;

class Lambdas
{
    void F(List<int> list)
    {
        list.ForEach(x => { Console.WriteLine(x); });
        list.Sort((a, b) => { return a - b; });
        Action nothing = () => { };
        Action<int> one = x =>
        {
            if (x > 0)
            {
                return;
            }
            Console.WriteLine(x);
        };
        Func<int, int> twice = x => { x++; return x * 2; };
        Action old = delegate { Console.WriteLine(1); };
        list.ForEach(x => list.ForEach(y => { Console.WriteLine(x + y); }));
        if (list.Count > 0)
        {
            list.ForEach(x => { Console.WriteLine(x); });
        }
        list.RemoveAll(x => x > 0);
    }
}
=== layout
using System;
using System.Collections.Generic;

class Lambdas
{
    void F(List<int> list)
    {
        list.ForEach(x =>
        {
            Console.WriteLine(x);
        });
        list.Sort((a, b) =>
        {
            return a - b;
        });
        Action nothing = () =>
        {
        };
        Action<int> one = x =>
        {
            if (x > 0)
            {
                return;
            }
            Console.WriteLine(x);
        };
        Func<int, int> twice = x =>
        {
            x++;
            return x * 2;
        };
        Action old = delegate
        {
            Console.WriteLine(1);
        };
        list.ForEach(x => list.ForEach(y =>
        {
            Console.WriteLine(x + y);
        }));
        if (list.Count > 0)
        {
            list.ForEach(x =>
            {
                Console.WriteLine(x);
            });
        }
        list.RemoveAll(x => x > 0);
    }
}
