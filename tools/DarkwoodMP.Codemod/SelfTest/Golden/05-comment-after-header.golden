class Headers
{
    int F(int a)
    {
        if (a > 0) // only positive ones
            return 1;
        for (int i = 0; i < a; i++) // walk it
            a--;
        while (a > 3) /* shrink */ a--;
        foreach (var c in "ab") // each letter
            // a comment of its own
            a += c;
        return a;
    }

    int Trailing(int a)
    {
        if (a > 0) return 1; // a trailing comment
        if (a < 0)
            return 2; // another
        else
            return 3; /* block */
    }

    void Comments(bool a, bool b)
    {
        if (a) { /* why */ if (b) C(); }
        if (a)

            // kept with the call
            C();
    }

    void C()
    {
    }
}
=== braces
class Headers
{
    int F(int a)
    {
        if (a > 0) // only positive ones
        {
            return 1;
        }
        for (int i = 0; i < a; i++) // walk it
        {
            a--;
        }
        while (a > 3) /* shrink */
        {
            a--;
        }
        foreach (var c in "ab") // each letter
        {
            // a comment of its own
            a += c;
        }
        return a;
    }

    int Trailing(int a)
    {
        if (a > 0)
        {
            return 1; // a trailing comment
        }
        if (a < 0)
        {
            return 2; // another
        }
        else
        {
            return 3; /* block */
        }
    }

    void Comments(bool a, bool b)
    {
        if (a)
        {
            /* why */
            if (b)
            {
                C();
            }
        }
        if (a)
        {
            // kept with the call
            C();
        }
    }

    void C()
    {
    }
}
=== layout
class Headers
{
    int F(int a)
    {
        if (a > 0) // only positive ones
        {
            return 1;
        }
        for (int i = 0; i < a; i++) // walk it
        {
            a--;
        }
        while (a > 3) /* shrink */
        {
            a--;
        }
        foreach (var c in "ab") // each letter
        {
            // a comment of its own
            a += c;
        }
        return a;
    }

    int Trailing(int a)
    {
        if (a > 0)
        {
            return 1; // a trailing comment
        }
        if (a < 0)
        {
            return 2; // another
        }
        else
        {
            return 3; /* block */
        }
    }

    void Comments(bool a, bool b)
    {
        if (a)
        {
            /* why */
            if (b)
            {
                C();
            }
        }
        if (a)
        {
            // kept with the call
            C();
        }
    }

    void C()
    {
    }
}
