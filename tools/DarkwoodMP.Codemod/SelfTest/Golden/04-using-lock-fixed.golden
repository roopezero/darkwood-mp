=== input
using System.IO;

class Guards
{
    readonly object _gate = new object();
    readonly object _other = new object();

    long Stacked(string name)
    {
        using (var a = File.OpenRead(name))
        using (var b = new BinaryReader(a))
            return b.ReadInt64();
    }

    void Locks(int[] list)
    {
        lock (_gate) list[0] = 1;
        lock (_gate)
        lock (_other)
            list[1] = 2;
    }

    unsafe void Pinned(byte[] data)
    {
        fixed (byte* p = data) *p = 1;
        fixed (byte* p = data)
            fixed (byte* q = data)
                *q = *p;
    }
}
=== braces
using System.IO;

class Guards
{
    readonly object _gate = new object();
    readonly object _other = new object();

    long Stacked(string name)
    {
        using (var a = File.OpenRead(name))
        {
            using (var b = new BinaryReader(a))
            {
                return b.ReadInt64();
            }
        }
    }

    void Locks(int[] list)
    {
        lock (_gate)
        {
            list[0] = 1;
        }
        lock (_gate)
        {
            lock (_other)
            {
                list[1] = 2;
            }
        }
    }

    unsafe void Pinned(byte[] data)
    {
        fixed (byte* p = data)
        {
            *p = 1;
        }
        fixed (byte* p = data)
        {
            fixed (byte* q = data)
            {
                *q = *p;
            }
        }
    }
}
=== layout
using System.IO;

class Guards
{
    readonly object _gate = new object();
    readonly object _other = new object();

    long Stacked(string name)
    {
        using (var a = File.OpenRead(name))
        {
            using (var b = new BinaryReader(a))
            {
                return b.ReadInt64();
            }
        }
    }

    void Locks(int[] list)
    {
        lock (_gate)
        {
            list[0] = 1;
        }
        lock (_gate)
        {
            lock (_other)
            {
                list[1] = 2;
            }
        }
    }

    unsafe void Pinned(byte[] data)
    {
        fixed (byte* p = data)
        {
            *p = 1;
        }
        fixed (byte* p = data)
        {
            fixed (byte* q = data)
            {
                *q = *p;
            }
        }
    }
}
