=== input
using System.Collections.Generic;

class Loops
{
    int Sum(int[] list, Dictionary<int, int> map)
    {
        int n = 0;
        for (int i = 0; i < list.Length; i++) n += list[i];
        for (int i = 0; i < list.Length; i++)
            n -= list[i];
        foreach (var x in list) n += x;
        foreach (var (key, value) in map) n += key + value;
        while (n > 100) n /= 2;
        while (n < 0)
            n += 10;
        do n++; while (n < 3);
        do
            n--;
        while (n > 50);
        do { n += 2; } while (n < 9);
        return n;
    }
}
=== braces
using System.Collections.Generic;

class Loops
{
    int Sum(int[] list, Dictionary<int, int> map)
    {
        int n = 0;
        for (int i = 0; i < list.Length; i++)
        {
            n += list[i];
        }
        for (int i = 0; i < list.Length; i++)
        {
            n -= list[i];
        }
        foreach (var x in list)
        {
            n += x;
        }
        foreach (var (key, value) in map)
        {
            n += key + value;
        }
        while (n > 100)
        {
            n /= 2;
        }
        while (n < 0)
        {
            n += 10;
        }
        do
        {
            n++;
        } while (n < 3);
        do
        {
            n--;
        }
        while (n > 50);
        do { n += 2; } while (n < 9);
        return n;
    }
}
=== layout
using System.Collections.Generic;

class Loops
{
    int Sum(int[] list, Dictionary<int, int> map)
    {
        int n = 0;
        for (int i = 0; i < list.Length; i++)
        {
            n += list[i];
        }
        for (int i = 0; i < list.Length; i++)
        {
            n -= list[i];
        }
        foreach (var x in list)
        {
            n += x;
        }
        foreach (var (key, value) in map)
        {
            n += key + value;
        }
        while (n > 100)
        {
            n /= 2;
        }
        while (n < 0)
        {
            n += 10;
        }
        do
        {
            n++;
        } while (n < 3);
        do
        {
            n--;
        }
        while (n > 50);
        do
        {
            n += 2;
        } while (n < 9);
        return n;
    }
}
