=== input
class Switches
{
    int F(int a)
    {
        switch (a)
        {
            case 1: a++; break;
            case 2: case 3: a--; break;
            case 4: if (a > 0) a = 9; break;
            case 5: { a = 5; break; }
            default: return 0;
        }
        return a;
    }

    int G(int a)
    {
        switch (a) { case 1: a = 2; break; default: a = 3; break; }
        switch (a) { }
        return a switch { 1 => 2, _ => 3 };
    }

    int H(int a)
    {
        switch (a) { /* c */ case 1: break; }
        switch (a) { case 1: a = 2; break; /* later */ case 2: a = 3; break; }
        switch (a)
        {
            case 1: a = 2; break; // why this section
            case 2: a = 3; a = 4; break; /* why that one */
            case 3: break; // nothing to hang it on
            case 4: if (a > 0) { a = 5; } break; // for all of the line
            case 5:
                a = 6;
                break; // on lines of their own already
        }
        return a;
    }
}
