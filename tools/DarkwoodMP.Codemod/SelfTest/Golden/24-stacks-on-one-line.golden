using System.Collections.Generic;
using System.IO;

class Stacks
{
    readonly object _gate = new object();
    readonly Dictionary<int, int> _map = new Dictionary<int, int>();

    public int Count { get
        {
            lock (_gate)
            {
                return _map.Count;
            }
        }
    }

    bool Find(int key, out int value)
    {
        lock (_gate)
        {
            if (!_map.TryGetValue(key, out value))
            {
                return false;
            }
        }
        return true;
    }

    long Read(string name)
    {
        using (var a = File.OpenRead(name))
        {
            using (var b = new BinaryReader(a))
            {
                return b.ReadInt64(); // both closed here
            }
        }
    }

    int Chain(int a)
    {
        if (a > 2)
        {
            a = 1; // the first
        }
        else if (a > 1)
        {
            a = 2; // the second
        }
        // above the last one
        else
        {
            a = 3; // the last
        }
        return a;
    }
}
=== layout
using System.Collections.Generic;
using System.IO;

class Stacks
{
    readonly object _gate = new object();
    readonly Dictionary<int, int> _map = new Dictionary<int, int>();

    public int Count
    {
        get
        {
            lock (_gate)
            {
                return _map.Count;
            }
        }
    }

    bool Find(int key, out int value)
    {
        lock (_gate)
        {
            if (!_map.TryGetValue(key, out value))
            {
                return false;
            }
        }
        return true;
    }

    long Read(string name)
    {
        using (var a = File.OpenRead(name))
        {
            using (var b = new BinaryReader(a))
            {
                return b.ReadInt64(); // both closed here
            }
        }
    }

    int Chain(int a)
    {
        if (a > 2)
        {
            a = 1; // the first
        }
        else if (a > 1)
        {
            a = 2; // the second
        }
        // above the last one
        else
        {
            a = 3; // the last
        }
        return a;
    }
}
