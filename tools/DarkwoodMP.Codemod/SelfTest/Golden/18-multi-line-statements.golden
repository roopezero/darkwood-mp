=== input
using System;

class MultiLine
{
    void Call(int a, int b, Action done) { }

    void F(int a)
    {
        if (a > 0)
            Call(1,
                 2,
                 () => { });
        if (a > 1) Call(
            a,
            2,
            () =>
            {
                a++;
            });
        else if (a > 2)
            Call(3, 4, () => a++);
    }
}
=== braces
using System;

class MultiLine
{
    void Call(int a, int b, Action done) { }

    void F(int a)
    {
        if (a > 0)
        {
            Call(1,
                 2,
                 () => { });
        }
        if (a > 1)
        {
            Call(
            a,
            2,
            () =>
            {
                a++;
            });
        }
        else if (a > 2)
        {
            Call(3, 4, () => a++);
        }
    }
}
=== layout
using System;

class MultiLine
{
    void Call(int a, int b, Action done)
    {
    }

    void F(int a)
    {
        if (a > 0)
        {
            Call(1,
                 2,
                 () =>
                 {
                 });
        }
        if (a > 1)
        {
            Call(
            a,
            2,
            () =>
            {
                a++;
            });
        }
        else if (a > 2)
        {
            Call(3, 4, () => a++);
        }
    }
}
