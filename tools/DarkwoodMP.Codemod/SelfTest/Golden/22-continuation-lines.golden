=== layout
using System;

class Continued
{
    int Call(int a, int b, Func<int> done) => a + b;

    int F(int a)
    {
        if (a > 0)
        {
            return Call(1,
                        2,
                        () => 3);
        }
        foreach (var c in "ab")
        {
            a += Call(1,
                      2,
                      () => 3);
        }
        return a;
    }

    int G(int a)
    {
        switch (a)
        {
            case 1:
                return Call(1,
                            2,
                            () => 3);
            case 2:
                return a > 1 ||
                       a < 0 ? 1 : 0;
            default:
                return 0;
        }
    }
}
