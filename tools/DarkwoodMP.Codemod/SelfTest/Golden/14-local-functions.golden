=== layout
class Locals
{
    int F(int a)
    {
        int Twice(int x)
        {
            return x * 2;
        }
        int Thrice(int x) => x * 3;
        static int Id(int x)
        {
            if (x > 0)
            {
                return x;
            }
            return -x;
        }
        void Nothing()
        {
        }
        Nothing();
        return Twice(a) + Thrice(a) + Id(a);
    }
}
