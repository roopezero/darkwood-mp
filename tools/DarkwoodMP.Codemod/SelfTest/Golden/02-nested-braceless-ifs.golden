=== input
class Nested
{
    int Dangling(bool a, bool b)
    {
        if (a)
            if (b)
                return 1;
            else
                return 2;
        return 3;
    }

    int OneLine(bool a, bool b)
    {
        if (a) if (b) return 1; else return 2;
        return 3;
    }

    int Deep(int[] list)
    {
        foreach (var x in list)
            if (x > 0)
                for (int i = 0; i < x; i++)
                    if (i == 3) return i;
        return -1;
    }
}
=== braces
class Nested
{
    int Dangling(bool a, bool b)
    {
        if (a)
        {
            if (b)
            {
                return 1;
            }
            else
            {
                return 2;
            }
        }
        return 3;
    }

    int OneLine(bool a, bool b)
    {
        if (a)
        {
            if (b)
            {
                return 1;
            }
            else
            {
                return 2;
            }
        }
        return 3;
    }

    int Deep(int[] list)
    {
        foreach (var x in list)
        {
            if (x > 0)
            {
                for (int i = 0; i < x; i++)
                {
                    if (i == 3)
                    {
                        return i;
                    }
                }
            }
        }
        return -1;
    }
}
=== layout
class Nested
{
    int Dangling(bool a, bool b)
    {
        if (a)
        {
            if (b)
            {
                return 1;
            }
            else
            {
                return 2;
            }
        }
        return 3;
    }

    int OneLine(bool a, bool b)
    {
        if (a)
        {
            if (b)
            {
                return 1;
            }
            else
            {
                return 2;
            }
        }
        return 3;
    }

    int Deep(int[] list)
    {
        foreach (var x in list)
        {
            if (x > 0)
            {
                for (int i = 0; i < x; i++)
                {
                    if (i == 3)
                    {
                        return i;
                    }
                }
            }
        }
        return -1;
    }
}
