=== layout
class Trailing
{
    int F(int a)
    {
        if (a > 0)
        {
            return 1;
        } // positive
        if (a < 0)
        {
            a = -a; /* flipped */
        } // negative
        if (a == 0)
        {
            /* nothing */
        }
        if (a == 1)
        {
            return 2;
        } /* one */
        else
        {
            return 3;
        } // done
        return a;
    }

    void G()
    {
    } // does nothing

    int H()
    {
        return 1;
    } /* one */
}
