=== layout
class Headers
{
    void F(int a)
    {
        if (a > 0)
        {
            a++;
        }
        else
        {
            a--;
        }
        if (a > 1)
        { // about this
            a--;
        }
        for (int i = 0; i < a; i++)
        {
            a--;
            a++;
        }
    }

    int G(int a)
    {
        return a;
    }
}

class Open
{
    int X;
}

